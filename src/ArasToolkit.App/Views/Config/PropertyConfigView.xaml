<UserControl x:Class="ArasToolkit.App.Views.PropertyConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ArasToolkit.App.Converters"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             Background="Transparent">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="属性配置" FontSize="24" FontWeight="Bold" Foreground="#111827" />
                <TextBlock Text="选择系统已有对象类，先组装并核对 AML，再按属性逐条即时提交。"
                           FontSize="13" Foreground="#6B7280" Margin="0,4,0,0" />
            </StackPanel>

            <Border Background="#EEF2FF" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                <TextBlock Foreground="#3730A3" FontSize="12" TextWrapping="Wrap"
                           Text="三语字段：简中(zc) / 繁中(zt) / 英文(en)。String 与 Multilingual String 默认长度 256；List 系列默认 64；Decimal 默认精度 10、小数位 2；显示顺序从 100 起每行递增 10。" />
            </Border>

            <UniformGrid Columns="4" Margin="0,0,0,14">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="1  下载模板" FontWeight="SemiBold" Foreground="#111827" />
                        <TextBlock Text="数据字典 + Office 原生下拉校验" FontSize="11" Foreground="#6B7280" Margin="0,4,0,12" />
                        <Button Content="保存最新模板" Command="{Binding DownloadTemplateCommand}"
                                Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="4,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="2  选择模板" FontWeight="SemiBold" Foreground="#111827" />
                        <TextBlock Text="读取后先完成本地字段预检" FontSize="11" Foreground="#6B7280" Margin="0,4,0,12" />
                        <Button Content="选择 .xlsx 模板" Command="{Binding BrowseFileCommand}"
                                Style="{StaticResource AccentButton}" />
                        <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="#374151"
                                   TextTrimming="CharacterEllipsis" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="4,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="3  选择系统对象类" FontWeight="SemiBold" Foreground="#111827" />
                        <ComboBox ItemsSource="{Binding ItemTypes}" SelectedItem="{Binding SelectedItemType}"
                                  DisplayMemberPath="DisplayName" Margin="0,10,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding ImportModeOptions}" SelectedItem="{Binding ImportMode}"
                                      Width="90" Margin="0,0,8,0" />
                            <Button Content="刷新" Command="{Binding RefreshItemTypesCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="8,0,0,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="4  组装与提交" FontWeight="SemiBold" Foreground="#111827" />
                        <TextBlock Text="{Binding ModeDescription}" FontSize="11" Foreground="#6B7280"
                                   TextWrapping="Wrap" Margin="0,4,0,10" />
                        <Button Content="组装并校验 AML" Command="{Binding PrepareAmlCommand}" Margin="0,0,0,7" />
                        <Button Content="开始逐条提交" Command="{Binding ExecuteImportCommand}"
                                Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Background="#F0FDF4" CornerRadius="8" Padding="12,9" Margin="0,0,0,8"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#166534" FontSize="12" TextWrapping="Wrap" />
            </Border>
            <Border Background="#FEF2F2" CornerRadius="8" Padding="12,9" Margin="0,0,0,8"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,14"
                    Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="330" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="16,12,16,8">
                        <TextBlock Text="AML 组装预览" FontWeight="SemiBold" Foreground="#111827" />
                        <TextBlock Text="{Binding PreviewSummary}" FontSize="11" Foreground="#6B7280" Margin="0,3,0,0" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding PreviewRows}" AutoGenerateColumns="False"
                              IsReadOnly="True" Style="{StaticResource FluentDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="行" Binding="{Binding ExcelRowNumber}" Width="50" />
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="130" />
                            <DataGridTextColumn Header="三语标签" Binding="{Binding LabelSummary}" Width="260" />
                            <DataGridTextColumn Header="类型标签 → AML值" Binding="{Binding TypeDisplay}" Width="170" />
                            <DataGridTextColumn Header="数据源" Binding="{Binding DataSource}" Width="150" />
                            <DataGridTextColumn Header="默认规则" Binding="{Binding RuleSummary}" Width="170" />
                            <DataGridTextColumn Header="计划动作" Binding="{Binding PlannedAction}" Width="110" />
                            <DataGridTextColumn Header="校验信息" Binding="{Binding ValidationMessage}" Width="*" />
                            <DataGridTemplateColumn Header="AML" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="查看" Tag="{Binding}" Click="ShowAml_Click" Padding="8,3" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <StackPanel Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                <Border Background="#ECFDF5" CornerRadius="8" Padding="12,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="停止后续提交" Command="{Binding CancelImportCommand}" />
                        <StackPanel>
                            <TextBlock Text="{Binding ProgressText}" Foreground="#166534" FontWeight="SemiBold" />
                            <TextBlock Text="成功的属性已即时保存；取消只停止后续请求。" FontSize="11" Foreground="#6B7280" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ProgressBar Value="{Binding ProgressPercentage}" IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Minimum="0" Maximum="100" Height="4" Margin="0,4,0,0" />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,14"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="查看详细日志" Click="OpenLogFile_Click"
                            Tag="{Binding LastResult.LogFilePath}" />
                    <StackPanel>
                        <TextBlock Text="本次提交结果" FontWeight="SemiBold" Foreground="#111827" />
                        <TextBlock Text="{Binding ResultSummary}" Foreground="#374151" Margin="0,5,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="230" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="导入历史" FontWeight="SemiBold" Foreground="#111827" />
                        <TextBlock Text="{Binding PageInfo}" FontSize="11" Foreground="#6B7280" Margin="12,2,0,0" />
                        <Button Content="刷新" Command="{Binding RefreshHistoryCommand}" Margin="12,0,0,0" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding HistoryRecords}" AutoGenerateColumns="False"
                              IsReadOnly="True" Style="{StaticResource FluentDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="80" />
                            <DataGridTextColumn Header="汇入时间" Binding="{Binding DisplayImportTime}" Width="160" />
                            <DataGridTextColumn Header="文件" Binding="{Binding ImportFile}" Width="260" />
                            <DataGridTextColumn Header="成功" Binding="{Binding Sheet1Count}" Width="70" />
                            <DataGridTextColumn Header="摘要" Binding="{Binding Summary}" Width="*" />
                            <DataGridTemplateColumn Header="操作" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="打开" Click="OpenImportFile_Click" Tag="{Binding}" Padding="8,3" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,9,0,0">
                        <Button Content="上一页" Command="{Binding PrevPageCommand}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding PageInfo}" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" />
                        <Button Content="下一页" Command="{Binding NextPageCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
