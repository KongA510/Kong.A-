<UserControl x:Class="ArasToolkit.App.Views.ClassStructureImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ArasToolkit.App.Converters"
             Background="Transparent">
    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MinWidth="1000">
            <TextBlock Text="🌳 类结构汇入" FontSize="24" FontWeight="Bold" Foreground="#111827" />
            <TextBlock Text="用 Excel 多级路径全量覆盖 ItemType.class_structure"
                       FontSize="13" Foreground="#6B7280" Margin="0,4,0,16" />

            <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <TextBlock Text="覆盖式汇入：旧 class_structure 不参与合并。第1级直接填写“模组 / 芯片”，不要填写 Document。"
                           Foreground="#9A3412" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="1  准备路径模板" FontSize="16" FontWeight="SemiBold" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Content="下载汇入模板" Command="{Binding DownloadTemplateCommand}" Style="{StaticResource PrimaryButton}" Padding="14,7" />
                        <Button Grid.Column="1" Content="选择已填写模板" Command="{Binding BrowseFileCommand}" Margin="8,0,0,0" Padding="14,7" />
                        <TextBlock Grid.Column="2" Text="{Binding SelectedFileName}" Margin="14,0,0,0" VerticalAlignment="Center"
                                   Foreground="#374151" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="2  选择覆盖目标" FontSize="16" FontWeight="SemiBold" />
                        <Grid Margin="0,12,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding QueryKeyword, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8" ToolTip="名称或中英文标签" />
                            <Button Grid.Column="1" Content="模糊查询" Command="{Binding QueryCommand}" Margin="8,0,0,0" Padding="14,0" />
                        </Grid>
                        <DataGrid ItemsSource="{Binding ItemTypes}" SelectedItem="{Binding SelectedItemType}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" Height="250" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="对象类名称" Binding="{Binding Name}" Width="150" />
                                <DataGridTextColumn Header="简体标签" Binding="{Binding LabelZc}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding SelectedTargetText}" Foreground="#4F46E5" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="3  核对组装预览" FontSize="16" FontWeight="SemiBold" />
                        <Border Background="#EEF2FF" CornerRadius="7" Padding="10,7" Margin="0,12,0,8">
                            <TextBlock Text="{Binding PreviewSummary}" Foreground="#4338CA" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                        <TextBox Text="{Binding PreviewTreeText}" FontFamily="Consolas" FontSize="13" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="NoWrap" Height="250"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="#EFF6FF" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#1D4ED8" TextWrapping="Wrap" />
            </Border>
            <Border Background="#FEF2F2" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" />
            </Border>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ProgressBar IsIndeterminate="True" Height="5" VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Column="1" Content="覆盖并汇入类结构" Command="{Binding ImportCommand}"
                        Style="{StaticResource PrimaryButton}" Padding="20,8" Margin="16,0,0,0" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
