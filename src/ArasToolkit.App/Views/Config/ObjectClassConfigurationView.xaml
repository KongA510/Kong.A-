<UserControl x:Class="ArasToolkit.App.Views.ObjectClassConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ArasToolkit.App.Converters"
             Background="Transparent">
    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MinWidth="1050">
            <TextBlock Text="⚙ 对象类配置" FontSize="24" FontWeight="Bold" Foreground="#111827" />
            <TextBlock Text="批量添加权限页签、设定可创建者和标准四状态生命周期"
                       FontSize="13" Foreground="#6B7280" Margin="0,4,0,16" />

            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="1  查询并选择对象类" FontSize="16" FontWeight="SemiBold" />
                    <Grid Margin="0,12,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding QueryKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34" Padding="8" ToolTip="名称或英文、简体、繁体标签；留空查询全部" />
                        <Button Grid.Column="1" Content="查询对象类" Command="{Binding QueryCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Padding="14,0" />
                        <Button Grid.Column="2" Content="全选" Command="{Binding SelectAllCommand}" Margin="8,0,0,0" Padding="12,0" />
                        <Button Grid.Column="3" Content="清空" Command="{Binding ClearSelectionCommand}" Margin="8,0,0,0" Padding="12,0" />
                    </Grid>
                    <TextBlock Text="{Binding SelectionSummary}" FontSize="12" Foreground="#6B7280" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding ItemTypes}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" Height="350" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="选择" Width="55">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  Click="SelectionCheckBox_Click" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="对象类名称" Binding="{Binding Name}" Width="170" />
                            <DataGridTextColumn Header="英文标签" Binding="{Binding LabelEn}" Width="145" />
                            <DataGridTextColumn Header="简体标签" Binding="{Binding LabelZc}" Width="145" />
                            <DataGridTextColumn Header="繁体标签" Binding="{Binding LabelZt}" Width="145" />
                            <DataGridTextColumn Header="默认权限" Binding="{Binding DefaultPermissionName}" Width="140" />
                            <DataGridTextColumn Header="执行结果" Binding="{Binding OperationSummary}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="2  选择一键基础设定" FontSize="16" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <CheckBox Content="添加到权限页签并设为默认" IsChecked="{Binding Options.ConfigureDefaultPermission}" Margin="0,0,28,0" />
                        <CheckBox Content="可创建者设定" IsChecked="{Binding Options.ConfigureCanAdd}" Margin="0,0,28,0" />
                        <CheckBox Content="生命周期与状态权限设定" IsChecked="{Binding Options.ConfigureLifecycle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="3  角色模板" FontSize="16" FontWeight="SemiBold" />
                        <Button Grid.Column="1" Content="恢复默认" Command="{Binding ResetSettingsCommand}" Margin="0,0,8,0" Padding="12,5" />
                        <Button Grid.Column="2" Content="保存角色配置" Command="{Binding SaveSettingsCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="14,5" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                            <TextBlock Text="新增状态完整权限角色" FontSize="12" Foreground="#6B7280" />
                            <TextBox Text="{Binding Settings.CreatorFullControlRoles, UpdateSourceTrigger=PropertyChanged}" Padding="8" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,10">
                            <TextBlock Text="一般只读/可查角色" FontSize="12" Foreground="#6B7280" />
                            <TextBox Text="{Binding Settings.ReadOnlyRoles, UpdateSourceTrigger=PropertyChanged}" Padding="8" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                            <TextBlock Text="管理员完整权限角色" FontSize="12" Foreground="#6B7280" />
                            <TextBox Text="{Binding Settings.AdministratorFullControlRoles, UpdateSourceTrigger=PropertyChanged}" Padding="8" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,10">
                            <TextBlock Text="可创建者角色" FontSize="12" Foreground="#6B7280" />
                            <TextBox Text="{Binding Settings.CanAddRoles, UpdateSourceTrigger=PropertyChanged}" Padding="8" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="生命周期转换角色（仅一个）" FontSize="12" Foreground="#6B7280" />
                            <TextBox Text="{Binding Settings.TransitionRole, UpdateSourceTrigger=PropertyChanged}" Padding="8" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="8,18,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#6B7280"
                                   Text="多个角色用逗号分隔；非 Preliminary 状态仅管理员保留编辑/删除权限。" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#EFF6FF" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#1D4ED8" TextWrapping="Wrap" />
            </Border>
            <Border Background="#FEF2F2" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" />
            </Border>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercentage}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}" Height="5" />
                    <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="#6B7280" Margin="0,5,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="取消" Command="{Binding CancelCommand}" Margin="12,0,8,0" Padding="14,7" />
                <Button Grid.Column="2" Content="一键设定基础设定" Command="{Binding ExecuteCommand}"
                        Style="{StaticResource PrimaryButton}" Padding="18,7" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
