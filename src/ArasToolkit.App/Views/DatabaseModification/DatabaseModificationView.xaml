<UserControl x:Class="ArasToolkit.App.Views.DatabaseModificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,36">
            <!-- 页面说明 -->
            <TextBlock Text="数据库修改模式" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="用 Excel 列占位符安全组装并批量执行 SQL，执行前先检查双预览。"
                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,14" />

            <!-- 执行方式与实际连接目标 -->
            <Border Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,0,12"
                    Background="#EEF2FF" BorderBrush="#C7D2FE">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="执行连接" FontSize="11" Foreground="#6366F1" />
                        <TextBlock Text="{Binding ActiveConnectionName}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ExecutionModes}"
                              SelectedItem="{Binding SelectedExecutionMode, Mode=TwoWay}"
                              Style="{StaticResource DarkComboBox}" Margin="8,0" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="刷新连接" Command="{Binding RefreshConnectionCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="14,7" />
                </Grid>
            </Border>

            <!-- Excel 文件与有效数据范围 -->
            <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="选择文件" Command="{Binding BrowseFileCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="14,7" />
                        <TextBlock Text="Excel 数据模板" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FileName}" FontSize="12" Margin="14,0,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <WrapPanel>
                        <TextBlock Text="工作表" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding SheetNames}" SelectedItem="{Binding SelectedSheetName, Mode=TwoWay}"
                                  Style="{StaticResource DarkComboBox}" Width="145" Margin="0,0,10,0" />
                        <TextBlock Text="起始行" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox Text="{Binding StartRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}" Width="56" Margin="0,0,8,0" />
                        <TextBlock Text="结束行" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox Text="{Binding EndRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}" Width="56" Margin="0,0,8,0" />
                        <TextBlock Text="起始列" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox Text="{Binding StartColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}" Width="56" Margin="0,0,8,0" />
                        <TextBlock Text="结束列" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox Text="{Binding EndColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}" Width="56" Margin="0,0,10,0" />
                        <Button Content="预览 Excel" Command="{Binding PreviewExcelCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="14,7" />
                    </WrapPanel>
                    <TextBlock Text="结束行/列填 -1 表示最后一行/所有有数据的列；默认从第 2 行、第 1 列开始。"
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,12" BorderBrush="#DDD6FE">
                <StackPanel>
                    <TextBlock Text="占位符映射" FontSize="11" FontWeight="SemiBold" Foreground="#6366F1" />
                    <TextBlock Text="{Binding ColumnMappingHint}" FontFamily="Consolas" FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,4" />
                    <TextBlock Text="示例：UPDATE dbo.Part SET name = @B WHERE id = @A；占位符外不要加引号。"
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- 双预览工作区：左侧 Excel，右侧 SQL -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="预览 1 · Excel 前 20 行" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                        <DataGrid ItemsSource="{Binding ExcelPreview.DefaultView}" AutoGenerateColumns="True"
                                  IsReadOnly="True" CanUserAddRows="False" Height="430"
                                  Style="{StaticResource DarkDataGrid}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="140" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="删除" Command="{Binding DeleteTemplateCommand}"
                                    Padding="11,6" Margin="6,0,0,0" />
                            <Button DockPanel.Dock="Right" Content="新建" Command="{Binding NewTemplateCommand}"
                                    Padding="11,6" />
                            <ComboBox ItemsSource="{Binding SavedTemplates}" DisplayMemberPath="TemplateName"
                                      SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                                      Style="{StaticResource DarkComboBox}" />
                        </DockPanel>
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding TemplateName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBox}" />
                            <Button Grid.Column="1" Content="保存方案" Command="{Binding SaveTemplateCommand}"
                                    Style="{StaticResource PrimaryButton}" Padding="12,7" Margin="8,0,0,0" />
                        </Grid>
                        <TextBox Grid.Row="2" Text="{Binding SqlTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" FontFamily="Consolas" FontSize="12"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource DarkTextBox}" Padding="8" />
                        <DockPanel Grid.Row="3" Margin="0,9,0,7">
                            <Button DockPanel.Dock="Right" Content="预览 SQL" Command="{Binding PreviewSqlCommand}"
                                    Style="{StaticResource PrimaryButton}" Padding="12,7" />
                            <TextBlock Text="预览 2 · 预组装 SQL（最多 20 条）" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBox Grid.Row="4" Text="{Binding SqlPreviewText}" IsReadOnly="True"
                                 AcceptsReturn="True" FontFamily="Consolas" FontSize="11" Height="210"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource DarkTextBox}" Padding="8" />
                    </Grid>
                </Border>
            </Grid>

            <!-- 并发设置、执行、取消与进度 -->
            <Border Style="{StaticResource CardStyle}" Padding="16,14">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="并发 Worker" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding MaxConcurrency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}" Width="54" Margin="0,0,10,0" />
                        <TextBlock Text="ORM 范围 1–10；Aras 方式固定串行。任务结束后 Worker 与连接立即释放。"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Button Content="执行数据库修改" Command="{Binding ExecuteCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="16,8" />
                        <Button Content="停止" Command="{Binding CancelCommand}" Padding="14,8"
                                Background="#DC2626" Foreground="White" BorderThickness="0" Margin="8,0,0,0" />
                    </WrapPanel>
                    <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100"
                                 Style="{StaticResource DarkProgressBar}" Height="6" Margin="0,12,0,6" />
                    <TextBlock Text="{Binding ProgressText}" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontSize="12"
                       TextWrapping="Wrap" Margin="0,10,0,0" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
