<Window
    x:Class="ArasToolkit.App.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="个人工具箱">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 登录层（未登录时显示） -->
        <Frame x:Name="LoginFrame"
               Grid.Row="0"
               Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

        <!-- 主界面层（登录后显示）：左侧导航 + 右侧内容 Frame -->
        <NavigationView x:Name="NavView"
                        Grid.Row="0"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Auto"
                        OpenPaneLength="260"
                        CompactPaneLength="48"
                        CompactModeThresholdWidth="720"
                        ExpandedModeThresholdWidth="1080"
                        PaneTitle="个人工具箱"
                        AlwaysShowHeader="False"
                        Background="Transparent"
                        ItemInvoked="NavView_ItemInvoked"
                        Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}">
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,8,0,12">
                    <Border Width="32" Height="32" CornerRadius="8"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE943;" FontSize="16" Foreground="White"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Aras Toolkit" FontWeight="SemiBold" />
                        <TextBlock Text="WinUI 3" Style="{ThemeResource CaptionText}" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>
            <Frame x:Name="ContentFrame" Background="Transparent" />
        </NavigationView>

        <!-- 状态栏 -->
        <Border Grid.Row="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,5">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="VersionText" FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text=".NET 8 · Windows App SDK · Fluent UI" FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
