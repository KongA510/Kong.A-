<Page
    x:Class="ArasToolkit.App.WinUI.Views.DatabaseModificationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="Page_SizeChanged">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,20,28,36" Spacing="14">
                <!-- 页面说明 -->
                <StackPanel Spacing="4">
                    <TextBlock Text="数据库修改模式" FontSize="26" FontWeight="Bold"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock Text="用 Excel 列占位符安全组装并批量执行参数化 SQL，执行前先检查双预览。"
                               FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- 执行方式与实际连接目标 -->
                <Border Style="{ThemeResource SimpleCard}" Padding="16,12"
                        BorderBrush="#C7D2FE" Background="#EEF2FF">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="9" Background="#6366F1">
                            <FontIcon Glyph="&#xE968;" FontSize="16" Foreground="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="执行连接" FontSize="11" Foreground="#6366F1" />
                            <TextBlock Text="{Binding ActiveConnectionName}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding ExecutionModes}"
                                  SelectedItem="{Binding SelectedExecutionMode, Mode=TwoWay}"
                                  Style="{ThemeResource DarkComboBox}" Width="130"
                                  VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Grid.Column="3" Content="刷新连接" Command="{Binding RefreshConnectionCommand}"
                                Style="{ThemeResource PrimaryButton}" Height="30" Padding="12,0"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Excel 文件与有效数据范围 -->
                <Border Style="{ThemeResource CardStyle}" Padding="16,14">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8B5;" FontSize="16" Foreground="#6366F1" />
                                <TextBlock Text="Excel 数据模板" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="12"
                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="选择文件" Command="{Binding BrowseFileCommand}"
                                    Style="{ThemeResource PrimaryButton}" Height="30" Padding="14,0" />
                        </Grid>

                        <StackPanel x:Name="RangePanel" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="工作表" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding SheetNames}" SelectedItem="{Binding SelectedSheetName, Mode=TwoWay}"
                                      Style="{ThemeResource DarkComboBox}" Width="150" />
                            <TextBlock Text="起始行" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                            <TextBox Text="{Binding StartRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{ThemeResource DarkTextBox}" Width="58" />
                            <TextBlock Text="结束行" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBox Text="{Binding EndRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{ThemeResource DarkTextBox}" Width="58" />
                            <TextBlock Text="起始列" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBox Text="{Binding StartColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{ThemeResource DarkTextBox}" Width="58" />
                            <TextBlock Text="结束列" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBox Text="{Binding EndColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{ThemeResource DarkTextBox}" Width="58" />
                            <Button Content="预览 Excel" Command="{Binding PreviewExcelCommand}"
                                    Style="{ThemeResource PrimaryButton}" Height="30" Padding="14,0" />
                        </StackPanel>

                        <TextBlock Text="结束行/列填 -1 表示读取最后一行/所有有数据的列；默认从第 2 行、第 1 列开始。"
                                   FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{ThemeResource SimpleCard}" Padding="14,10" BorderBrush="#DDD6FE">
                    <StackPanel Spacing="4">
                        <TextBlock Text="占位符映射" FontSize="11" FontWeight="SemiBold" Foreground="#6366F1" />
                        <TextBlock Text="{Binding ColumnMappingHint}" FontSize="12" FontFamily="Consolas"
                                   Foreground="{ThemeResource TextPrimaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="示例：UPDATE dbo.Part SET name = @B WHERE id = @A；占位符外不要加引号。"
                                   FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 双预览工作区：左侧 Excel，右侧 SQL 模板与预组装结果 -->
                <Grid x:Name="WorkspaceGrid" ColumnSpacing="12" RowSpacing="12" MinHeight="500">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="0" />
                    </Grid.RowDefinitions>

                    <Border x:Name="ExcelPreviewPanel" Grid.Column="0" Style="{ThemeResource CardStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Padding="14,11" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="预览 1 · Excel 前 20 行" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                            </Border>
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto" MaxHeight="570">
                                <Grid MinHeight="260">
                                    <StackPanel x:Name="ExcelPreviewContainer" />
                                    <TextBlock x:Name="ExcelPreviewPlaceholder"
                                               Text="选择文件后点击“预览 Excel”"
                                               FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border x:Name="SqlWorkspacePanel" Grid.Column="1" Style="{ThemeResource CardStyle}" Padding="16,14">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="160" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding SavedTemplates}"
                                          SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                                          Style="{ThemeResource DarkComboBox}" PlaceholderText="选择已保存 SQL 方案">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TemplateName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1" Content="新建" Command="{Binding NewTemplateCommand}"
                                        Style="{ThemeResource PrimaryButton}" Height="30" Padding="12,0" />
                                <Button Grid.Column="2" Content="删除" Command="{Binding DeleteTemplateCommand}"
                                        Height="30" Padding="12,0" />
                            </Grid>

                            <Grid Grid.Row="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding TemplateName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="SQL 方案名称" Style="{ThemeResource DarkTextBox}" />
                                <Button Grid.Column="1" Content="保存方案" Command="{Binding SaveTemplateCommand}"
                                        Style="{ThemeResource PrimaryButton}" Height="32" Padding="14,0" />
                            </Grid>

                            <TextBox Grid.Row="2" Text="{Binding SqlTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                                     Style="{ThemeResource DarkTextBox}" Padding="10"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />

                            <Grid Grid.Row="3">
                                <TextBlock Text="预览 2 · 预组装 SQL（最多 20 条）" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Button Content="预览 SQL" Command="{Binding PreviewSqlCommand}"
                                        Style="{ThemeResource PrimaryButton}" Height="30" Padding="14,0"
                                        HorizontalAlignment="Right" />
                            </Grid>

                            <TextBox Grid.Row="4" Text="{Binding SqlPreviewText, Mode=OneWay}"
                                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                     FontFamily="Consolas" FontSize="11" PlaceholderText="预组装 SQL 将显示在这里"
                                     Style="{ThemeResource DarkTextBox}" Padding="10"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- 并发设置、执行、取消与进度 -->
                <Border Style="{ThemeResource CardStyle}" Padding="16,14">
                    <StackPanel Spacing="10">
                        <StackPanel x:Name="ExecutionPanel" Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="并发 Worker" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBox Text="{Binding MaxConcurrency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{ThemeResource DarkTextBox}" Width="54" />
                            <TextBlock Text="范围 1–10；执行结束后 Worker 与数据库连接立即释放。"
                                       FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Button Content="执行数据库修改" Command="{Binding ExecuteCommand}"
                                    Style="{ThemeResource AccentButton}" Height="34" Padding="18,0"
                                    Margin="10,0,0,0" />
                            <Button Content="停止" Command="{Binding CancelCommand}"
                                    Height="34" Padding="16,0" Background="#DC2626" Foreground="White"
                                    BorderThickness="0" />
                        </StackPanel>
                        <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="6" />
                        <TextBlock Text="{Binding ProgressText}" FontSize="11"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                        CornerRadius="8" Padding="12,9"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="#B91C1C" TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                           Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
