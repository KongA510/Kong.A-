<Page
    x:Class="ArasToolkit.App.WinUI.Views.PropertyConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="Page_SizeChanged">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <StackPanel x:Name="PageContent" Margin="32,24,32,36" Spacing="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="属性配置" Style="{ThemeResource PageTitleText}" />
                    <TextBlock Text="选择系统已有对象类，先组装并核对 AML，再按属性逐条即时提交。"
                               Style="{ThemeResource PageSubtitleText}" />
                </StackPanel>
                <Border Grid.Column="1" Padding="12,7" CornerRadius="16"
                        Background="#EEF2FF" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE8EF;" FontSize="14" Foreground="#4F46E5" />
                        <TextBlock Text="source_id + name 唯一" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#4338CA" />
                    </StackPanel>
                </Border>
            </Grid>

            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                     Title="模板与类型规则"
                     Message="标签、默认值、提示均支持简中(zc)、繁中(zt)、英文(en)。String/Multilingual String 默认长度 256；List 系列默认 64；Decimal 默认精度 10、小数位 2；显示顺序从 100 起每行递增 10。" />
            <InfoBar IsOpen="{Binding HasError}" IsClosable="False" Severity="Error"
                     Title="操作失败" Message="{Binding ErrorMessage}" />
            <InfoBar IsOpen="{Binding HasStatus}" IsClosable="False" Severity="Informational"
                     Title="当前状态" Message="{Binding StatusMessage}" />

            <Grid x:Name="StepGrid" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="1.55*" />
                    <ColumnDefinition Width="1.25*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="StepOneCard" Grid.Column="0" Style="{ThemeResource SimpleCard}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Width="28" Height="28" CornerRadius="14" Background="#4F46E5">
                                <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="White" FontWeight="Bold" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="下载模板" Style="{ThemeResource SectionTitleText}" />
                                <TextBlock Text="含数据字典和 Office 下拉校验" Style="{ThemeResource CaptionText}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Command="{Binding DownloadTemplateCommand}"
                                Style="{ThemeResource FluentButton}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="14" />
                                <TextBlock Text="保存最新模板" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border x:Name="StepTwoCard" Grid.Column="1" Style="{ThemeResource SimpleCard}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Width="28" Height="28" CornerRadius="14" Background="#4F46E5">
                                <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="White" FontWeight="Bold" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="选择并预检模板" Style="{ThemeResource SectionTitleText}" />
                                <TextBlock Text="先校验本地字段与默认规则" Style="{ThemeResource CaptionText}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Command="{Binding BrowseFileCommand}"
                                Style="{ThemeResource AccentButton}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                <TextBlock Text="选择 .xlsx 模板" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextPrimaryBrush}" FontSize="12" />
                    </StackPanel>
                </Border>

                <Border x:Name="StepThreeCard" Grid.Column="2" Style="{ThemeResource SimpleCard}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Width="28" Height="28" CornerRadius="14" Background="#4F46E5">
                                <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="White" FontWeight="Bold" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="选择目标对象类" Style="{ThemeResource SectionTitleText}" />
                                <TextBlock Text="目标必须来自当前 Aras 系统" Style="{ThemeResource CaptionText}" />
                            </StackPanel>
                        </StackPanel>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding ItemTypes}"
                                      SelectedItem="{Binding SelectedItemType, Mode=TwoWay}"
                                      PlaceholderText="选择系统对象类">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Command="{Binding RefreshItemTypesCommand}"
                                    Style="{ThemeResource CompactButton}" ToolTipService.ToolTip="刷新对象类">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                        </Grid>
                        <AutoSuggestBox PlaceholderText="按名称或标签搜索" IsEnabled="{Binding IsIdle}"
                                        Text="{Binding ItemTypeSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ItemsSource="{Binding FilteredItemTypes}"
                                        SuggestionChosen="ItemTypeSearchBox_SuggestionChosen"
                                        QuerySubmitted="ItemTypeSearchBox_QuerySubmitted">
                            <AutoSuggestBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Name}" Style="{ThemeResource CaptionText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </AutoSuggestBox.ItemTemplate>
                        </AutoSuggestBox>
                        <ComboBox Header="写入模式" ItemsSource="{Binding ImportModeOptions}"
                                  SelectedItem="{Binding ImportMode, Mode=TwoWay}" IsEnabled="{Binding IsIdle}" />
                    </StackPanel>
                </Border>

                <Border x:Name="StepFourCard" Grid.Column="3" Style="{ThemeResource SimpleCard}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Width="28" Height="28" CornerRadius="14" Background="#4F46E5">
                                <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="White" FontWeight="Bold" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="组装与提交" Style="{ThemeResource SectionTitleText}" />
                                <TextBlock Text="逐条写入后自动保存对象类" Style="{ThemeResource CaptionText}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding ModeDescription}" TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionText}" />
                        <Button Command="{Binding PrepareAmlCommand}"
                                Style="{ThemeResource FluentButton}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE943;" FontSize="14" />
                                <TextBlock Text="组装并校验 AML" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExecuteImportCommand}"
                                Style="{ThemeResource AccentButton}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                <TextBlock Text="开始逐条提交" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Padding="18,16" CornerRadius="12" Background="#EEF2FF"
                    BorderBrush="#C7D2FE" BorderThickness="1"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing Width="36" Height="36" IsActive="{Binding IsBusy}"
                                      Foreground="#4F46E5" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{Binding BusyTitle}" FontWeight="SemiBold" Foreground="#3730A3" />
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#4338CA" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding BusyElapsedText}" FontSize="12"
                                   Foreground="#6366F1" VerticalAlignment="Top" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="16"
                                Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding PreparationStageText}" FontSize="12" Foreground="#4338CA" />
                        <TextBlock Text="{Binding SubmissionStageText}" FontSize="12" Foreground="#4338CA" />
                        <TextBlock Text="{Binding SaveStageText}" FontSize="12" Foreground="#4338CA" />
                    </StackPanel>
                    <ProgressBar IsIndeterminate="{Binding IsProgressIndeterminate}"
                                 Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="5" />
                    <Grid Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="总进度" Style="{ThemeResource CaptionText}" />
                            <TextBlock Text="{Binding ProgressPercentage, Converter={StaticResource StringFormat}, ConverterParameter='{}{0:F1}%'}"
                                       Foreground="#4338CA" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="· 失败" Style="{ThemeResource CaptionText}" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding ImportErrorCount}" Foreground="#DC2626" FontSize="12" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding CancelButtonText}" Command="{Binding CancelImportCommand}"
                                Style="{ThemeResource FluentButton}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{ThemeResource SimpleCard}" Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="360" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="AML 组装预览" Style="{ThemeResource SectionTitleText}" />
                            <TextBlock Text="{Binding PreviewSummary}" Style="{ThemeResource CaptionText}" Margin="0,3,0,0" />
                        </StackPanel>
                        <ProgressRing Grid.Column="1" Width="24" Height="24" IsActive="{Binding IsBusy}" />
                    </Grid>
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{ThemeResource BorderBrush}"
                            BorderThickness="0,1,0,1" Padding="10,8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="1.7*" />
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="行 / 状态" Style="{ThemeResource TableHeaderText}" />
                            <TextBlock Grid.Column="1" Text="名称 / 三语标签" Style="{ThemeResource TableHeaderText}" />
                            <TextBlock Grid.Column="2" Text="数据类型 / 数据源" Style="{ThemeResource TableHeaderText}" />
                            <TextBlock Grid.Column="3" Text="默认规则" Style="{ThemeResource TableHeaderText}" />
                            <TextBlock Grid.Column="4" Text="校验信息" Style="{ThemeResource TableHeaderText}" />
                            <TextBlock Grid.Column="5" Text="操作" Style="{ThemeResource TableHeaderText}" />
                        </Grid>
                    </Border>
                    <ListView Grid.Row="2" ItemsSource="{Binding PreviewRows}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource TableRowContainer}" />
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10,9" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="1.7*" />
                                        <ColumnDefinition Width="1.05*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ExcelRowNumber}" Style="{ThemeResource TableCellText}" />
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <ProgressRing Width="12" Height="12" IsActive="{Binding IsSubmitting}"
                                                          Visibility="{Binding IsSubmitting, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding SubmitStatus}" Style="{ThemeResource CaptionText}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding LabelSummary}" Style="{ThemeResource CaptionText}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding TypeDisplay}" Style="{ThemeResource TableCellText}" />
                                        <TextBlock Text="{Binding DataSource}" Style="{ThemeResource CaptionText}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="{Binding RuleSummary}" Style="{ThemeResource TableCellText}" />
                                        <TextBlock Text="{Binding PlannedAction}" Foreground="#4F46E5" FontSize="11" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="4" Text="{Binding ValidationMessage}"
                                               TextWrapping="Wrap" FontSize="11" Foreground="#DC2626" />
                                    <Button Grid.Column="5" Content="查看 AML" Tag="{Binding}"
                                            Click="ShowAml_Click" IsEnabled="{Binding HasAmlPreview}"
                                            Style="{ThemeResource CompactButton}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Style="{ThemeResource SimpleCard}"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="本次提交结果" Style="{ThemeResource SectionTitleText}" />
                        <TextBlock Text="{Binding ResultSummary}" Margin="0,6,0,0"
                                   Foreground="{ThemeResource TextPrimaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ObjectSaveSummary}" Margin="0,6,0,0"
                                   Foreground="{ThemeResource TextPrimaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="查看详细日志" Click="OpenLogFile_Click"
                            Tag="{Binding LastResult.LogFilePath}" Style="{ThemeResource FluentButton}"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{ThemeResource SimpleCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="220" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,13,16,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="导入历史" Style="{ThemeResource SectionTitleText}" />
                            <TextBlock Text="{Binding PageInfo}" Style="{ThemeResource CaptionText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshHistoryCommand}"
                                Style="{ThemeResource CompactButton}" />
                    </Grid>
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{ThemeResource BorderBrush}"
                            BorderThickness="0,1,0,1" Padding="16,8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="状态" Style="{ThemeResource TableHeaderText}" />
                            <TextBlock Grid.Column="1" Text="汇入时间" Style="{ThemeResource TableHeaderText}" />
                            <TextBlock Grid.Column="2" Text="归档文件" Style="{ThemeResource TableHeaderText}" />
                            <TextBlock Grid.Column="3" Text="成功" Style="{ThemeResource TableHeaderText}" />
                            <TextBlock Grid.Column="4" Text="摘要" Style="{ThemeResource TableHeaderText}" />
                            <TextBlock Grid.Column="5" Text="操作" Style="{ThemeResource TableHeaderText}" />
                        </Grid>
                    </Border>
                    <ListView Grid.Row="2" ItemsSource="{Binding HistoryRecords}" Style="{ThemeResource TableListView}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="16,9" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding StatusText}" Style="{ThemeResource TableCellText}" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayImportTime}" Style="{ThemeResource TableCellText}" />
                                    <TextBlock Grid.Column="2" Text="{Binding ImportFile}" Style="{ThemeResource TableCellText}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding Sheet1Count}" Style="{ThemeResource TableCellText}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Summary}" Style="{ThemeResource TableCellText}" />
                                    <Button Grid.Column="5" Content="打开" Click="OpenImportFile_Click" Tag="{Binding}"
                                            Style="{ThemeResource CompactButton}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
                                Spacing="8" Margin="0,10,0,14">
                        <Button Content="上一页" Command="{Binding PrevPageCommand}" Style="{ThemeResource PagingButton}" />
                        <TextBlock Text="{Binding PageInfo}" Style="{ThemeResource CaptionText}" VerticalAlignment="Center" />
                        <Button Content="下一页" Command="{Binding NextPageCommand}" Style="{ThemeResource PagingButton}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
