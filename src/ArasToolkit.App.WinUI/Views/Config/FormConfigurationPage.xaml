<Page
    x:Class="ArasToolkit.App.WinUI.Views.FormConfigurationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24,32,36" MinWidth="960" Spacing="18">
                <StackPanel Spacing="4">
                    <TextBlock Text="窗体配置" Style="{ThemeResource PageTitleText}" />
                    <TextBlock Text="按 Aras 经典窗体规范生成对象类字段布局，并在写入前提供完整预览。"
                               Style="{ThemeResource PageSubtitleText}" />
                </StackPanel>

                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                         Title="默认布局规则"
                         Message="自动读取未勾选“搜索中隐藏”的属性；起点 X=50、Y=50；每行四个；横向间隔 200、纵向间隔 50；Item 显示长度 135，其余文本字段 150。第一行优先固定为创建者、创建时间、状态、编号（存在时）。" />

                <InfoBar IsOpen="{Binding HasError}" IsClosable="False" Severity="Error"
                         Title="操作失败" Message="{Binding ErrorMessage}" />
                <InfoBar IsOpen="{Binding HasStatus}" IsClosable="False" Severity="Success"
                         Title="当前状态" Message="{Binding StatusMessage}" />

                <Border Style="{ThemeResource SimpleCard}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="1  选择对象类" Style="{ThemeResource SectionTitleText}" />
                        <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ComboBox Grid.Row="0" Grid.Column="0"
                                      Header="Aras 对象类"
                                      ItemsSource="{Binding ItemTypes}"
                                      SelectedItem="{Binding SelectedItemType, Mode=TwoWay}"
                                      PlaceholderText="请先连接 Aras">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Header="窗体名称"
                                     Text="{Binding FormName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="例如：Part 自动窗体" />

                            <Button Grid.Row="0" Grid.Column="2" VerticalAlignment="Bottom"
                                    Command="{Binding RefreshItemTypesCommand}" Style="{ThemeResource FluentButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="刷新对象类" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="0" Grid.Column="3" VerticalAlignment="Bottom"
                                    Command="{Binding LoadPropertiesCommand}" Style="{ThemeResource AccentButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                    <TextBlock Text="加载属性" />
                                </StackPanel>
                            </Button>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                        Orientation="Horizontal" Spacing="20">
                                <CheckBox Content="覆盖同名窗体" IsChecked="{Binding ReplaceExisting, Mode=TwoWay}" />
                                <CheckBox Content="设为对象类默认视图" IsChecked="{Binding SetAsDefaultView, Mode=TwoWay}" />
                                <ProgressRing Width="20" Height="20" IsActive="{Binding IsBusy}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="7*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{ThemeResource SimpleCard}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="360" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="2  选择属性" Style="{ThemeResource SectionTitleText}" />
                                <Button Grid.Column="1" Content="全选" Command="{Binding SelectAllCommand}"
                                        Style="{ThemeResource CompactButton}" Margin="0,0,8,0" />
                                <Button Grid.Column="2" Content="清空" Command="{Binding ClearAllCommand}"
                                        Style="{ThemeResource CompactButton}" />
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding PropertySummary}"
                                       Style="{ThemeResource CaptionText}" />
                            <ListView Grid.Row="2" ItemsSource="{Binding Properties}"
                                      SelectionMode="None" IsItemClickEnabled="False">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource TableRowContainer}" />
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="4,7" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayLabel}" Style="{ThemeResource TableCellText}" />
                                                <TextBlock Text="{Binding Name}" Style="{ThemeResource CaptionText}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding DataType}"
                                                       Style="{ThemeResource TableCellText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{ThemeResource SimpleCard}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="318" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="3  布局预览" Style="{ThemeResource SectionTitleText}" />
                                <Button Grid.Column="1" Command="{Binding BuildPreviewCommand}"
                                        Style="{ThemeResource FluentButton}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7C1;" FontSize="14" />
                                        <TextBlock Text="重新生成" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding LayoutSummary}"
                                       Style="{ThemeResource CaptionText}" />
                            <Grid Grid.Row="2" Padding="8,8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="#" Style="{ThemeResource TableHeaderText}" />
                                <TextBlock Grid.Column="1" Text="字段" Style="{ThemeResource TableHeaderText}" />
                                <TextBlock Grid.Column="2" Text="控件类型" Style="{ThemeResource TableHeaderText}" />
                                <TextBlock Grid.Column="3" Text="X" Style="{ThemeResource TableHeaderText}" />
                                <TextBlock Grid.Column="4" Text="Y" Style="{ThemeResource TableHeaderText}" />
                                <TextBlock Grid.Column="5" Text="显示长度" Style="{ThemeResource TableHeaderText}" />
                            </Grid>
                            <ListView Grid.Row="3" ItemsSource="{Binding LayoutFields}"
                                      Style="{ThemeResource TableListView}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="8,7" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Sequence}" Style="{ThemeResource TableCellText}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Label}" Style="{ThemeResource TableCellText}" />
                                                <TextBlock Text="{Binding Name}" Style="{ThemeResource CaptionText}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding FieldType}" Style="{ThemeResource TableCellText}" />
                                            <TextBlock Grid.Column="3" Text="{Binding X}" Style="{ThemeResource TableCellText}" />
                                            <TextBlock Grid.Column="4" Text="{Binding Y}" Style="{ThemeResource TableCellText}" />
                                            <TextBlock Grid.Column="5" Text="{Binding DisplayLength}" Style="{ThemeResource TableCellText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="写入前会再次确认；未启用覆盖时不会修改同名窗体。"
                               VerticalAlignment="Center" Style="{ThemeResource CaptionText}" />
                    <Button Grid.Column="1" Command="{Binding ApplyCommand}"
                            Style="{ThemeResource AccentButton}" Padding="24,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontSize="15" />
                            <TextBlock Text="写入 Aras 窗体" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
