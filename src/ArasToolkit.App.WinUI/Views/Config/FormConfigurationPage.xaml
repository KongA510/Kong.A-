<Page
    x:Class="ArasToolkit.App.WinUI.Views.FormConfigurationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="Page_SizeChanged">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">
            <StackPanel x:Name="PageContent" Margin="32,24,32,36" Spacing="18"
                        HorizontalAlignment="Stretch">
                <StackPanel Spacing="4">
                    <TextBlock Text="窗体配置" Style="{ThemeResource PageTitleText}" />
                    <TextBlock Text="按 Aras 经典窗体规范生成对象类字段布局，并在写入前提供完整预览。"
                               Style="{ThemeResource PageSubtitleText}" />
                </StackPanel>

                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                         Title="默认布局规则"
                         Message="常规字段每行四个；属性类型 text 默认映射为 Text Area 并排列在最后，每行两个，X=50/450、Y 间隔 150。预览中除字段名称外均可调整。" />

                <InfoBar IsOpen="{Binding HasError}" IsClosable="False" Severity="Error"
                         Title="操作失败" Message="{Binding ErrorMessage}" />
                <InfoBar IsOpen="{Binding HasStatus}" IsClosable="False" Severity="Informational"
                         Title="当前状态" Message="{Binding StatusMessage}" />

                <Border Style="{ThemeResource SimpleCard}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="1  选择对象类" Style="{ThemeResource SectionTitleText}" />
                        <Grid x:Name="SelectionGrid" ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ComboBox x:Name="ItemTypeComboBox" Grid.Row="0" Grid.Column="0"
                                      Header="Aras 对象类"
                                      ItemsSource="{Binding ItemTypes}"
                                      SelectedItem="{Binding SelectedItemType, Mode=TwoWay}"
                                      PlaceholderText="请先连接 Aras">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <AutoSuggestBox x:Name="ItemTypeSearchBox" Grid.Row="0" Grid.Column="1"
                                            Header="搜索对象类"
                                            PlaceholderText="输入名称或标签进行模糊搜索"
                                            Text="{Binding ItemTypeSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ItemsSource="{Binding FilteredItemTypes}"
                                            SuggestionChosen="ItemTypeSearchBox_SuggestionChosen"
                                            QuerySubmitted="ItemTypeSearchBox_QuerySubmitted">
                                <AutoSuggestBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Name}" Style="{ThemeResource CaptionText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </AutoSuggestBox.ItemTemplate>
                            </AutoSuggestBox>

                            <TextBox x:Name="FormNameTextBox" Grid.Row="0" Grid.Column="2"
                                     Header="窗体名称"
                                     Text="{Binding FormName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="例如：Part 自动窗体" />

                            <Button x:Name="RefreshItemTypesButton" Grid.Row="0" Grid.Column="3"
                                    VerticalAlignment="Bottom"
                                    Command="{Binding RefreshItemTypesCommand}"
                                    Style="{ThemeResource FluentButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="刷新对象类" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="LoadPropertiesButton" Grid.Row="0" Grid.Column="4"
                                    VerticalAlignment="Bottom"
                                    Command="{Binding LoadPropertiesCommand}"
                                    Style="{ThemeResource AccentButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                    <TextBlock Text="加载属性" />
                                </StackPanel>
                            </Button>

                            <StackPanel x:Name="SelectionOptions" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                                        Orientation="Horizontal" Spacing="20">
                                <CheckBox Content="覆盖同名窗体" IsChecked="{Binding ReplaceExisting, Mode=TwoWay}" />
                                <CheckBox Content="设为对象类默认视图" IsChecked="{Binding SetAsDefaultView, Mode=TwoWay}" />
                                <TextBox Header="窗体高度（px）" Width="150" Text="{Binding FormHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ProgressRing Width="20" Height="20" IsActive="{Binding IsBusy}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid x:Name="WorkspaceGrid" ColumnSpacing="18" RowSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="7*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="PropertiesCard" Grid.Row="0" Grid.Column="0"
                            Style="{ThemeResource SimpleCard}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="360" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="2  选择属性" Style="{ThemeResource SectionTitleText}" />
                                <Button Grid.Column="1" Content="全选" Command="{Binding SelectAllCommand}"
                                        Style="{ThemeResource CompactButton}" Margin="0,0,8,0" />
                                <Button Grid.Column="2" Content="清空" Command="{Binding ClearAllCommand}"
                                        Style="{ThemeResource CompactButton}" />
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding PropertySummary}"
                                       Style="{ThemeResource CaptionText}" />
                            <ListView Grid.Row="2" ItemsSource="{Binding Properties}"
                                      SelectionMode="None" IsItemClickEnabled="False">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource TableRowContainer}" />
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="4,7" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="96" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayLabel}" Style="{ThemeResource TableCellText}" />
                                                <TextBlock Text="{Binding Name}" Style="{ThemeResource CaptionText}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding DataType}"
                                                       Style="{ThemeResource TableCellText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <Border x:Name="PreviewCard" Grid.Row="0" Grid.Column="1"
                            Style="{ThemeResource SimpleCard}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="360" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="3  布局预览" Style="{ThemeResource SectionTitleText}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE700;" FontSize="12"
                                                  Foreground="{ThemeResource AccentBrush}" />
                                        <TextBlock Text="拖动调整写入顺序；控件、坐标、尺寸与样式可直接编辑"
                                                   Style="{ThemeResource CaptionText}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding BuildPreviewCommand}"
                                        Style="{ThemeResource FluentButton}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7C1;" FontSize="14" />
                                        <TextBlock Text="恢复默认顺序" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding LayoutSummary}"
                                       Style="{ThemeResource CaptionText}" />
                            <ScrollViewer Grid.Row="2"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalContentAlignment="Stretch">
                                <Grid MinWidth="960">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="318" />
                                    </Grid.RowDefinitions>
                                    <Grid Padding="6,8"
                                          Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="132" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="68" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE700;" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="#" Style="{ThemeResource TableHeaderText}" />
                                        <TextBlock Grid.Column="2" Text="字段" Style="{ThemeResource TableHeaderText}" />
                                        <TextBlock Grid.Column="3" Text="控件类型" Style="{ThemeResource TableHeaderText}" />
                                        <TextBlock Grid.Column="4" Text="X" Style="{ThemeResource TableHeaderText}" />
                                        <TextBlock Grid.Column="5" Text="Y" Style="{ThemeResource TableHeaderText}" />
                                        <TextBlock Grid.Column="6" Text="显示长度" Style="{ThemeResource TableHeaderText}" />
                                        <TextBlock Grid.Column="7" Text="行数" Style="{ThemeResource TableHeaderText}" />
                                        <TextBlock Grid.Column="8" Text="列数" Style="{ThemeResource TableHeaderText}" />
                                        <TextBlock Grid.Column="9" Text="不可编辑" Style="{ThemeResource TableHeaderText}" />
                                        <TextBlock Grid.Column="10" Text="标题颜色" Style="{ThemeResource TableHeaderText}" />
                                    </Grid>
                                    <ListView x:Name="LayoutList" Grid.Row="1"
                                              ItemsSource="{Binding LayoutFields}"
                                              Style="{ThemeResource TableListView}"
                                              AllowDrop="True" CanDragItems="True" CanReorderItems="True"
                                              DragItemsCompleted="LayoutList_DragItemsCompleted">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="6,6" ColumnSpacing="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="38" />
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="132" />
                                                        <ColumnDefinition Width="62" />
                                                        <ColumnDefinition Width="62" />
                                                        <ColumnDefinition Width="88" />
                                                        <ColumnDefinition Width="72" />
                                                        <ColumnDefinition Width="72" />
                                                        <ColumnDefinition Width="68" />
                                                        <ColumnDefinition Width="140" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE700;" FontSize="13"
                                                              Foreground="{ThemeResource TextSecondaryBrush}"
                                                              VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Sequence}"
                                                               Style="{ThemeResource TableCellText}" />
                                                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Label}" Style="{ThemeResource TableCellText}" />
                                                        <TextBlock Text="{Binding Name}" Style="{ThemeResource CaptionText}" />
                                                    </StackPanel>
                                                    <ComboBox Grid.Column="3" Margin="2,0,6,0" MinWidth="0"
                                                              ItemsSource="{Binding AvailableFieldTypes}"
                                                              SelectedItem="{Binding FieldTypeLabel, Mode=TwoWay}" />
                                                    <NumberBox Grid.Column="4" Margin="2,0,6,0" MinWidth="0"
                                                               Minimum="0" SpinButtonPlacementMode="Hidden"
                                                               Value="{Binding X, Mode=TwoWay, Converter={StaticResource IntToDouble}, ConverterParameter=AllowZero}" />
                                                    <NumberBox Grid.Column="5" Margin="2,0,6,0" MinWidth="0"
                                                               Minimum="0" SpinButtonPlacementMode="Hidden"
                                                               Value="{Binding Y, Mode=TwoWay, Converter={StaticResource IntToDouble}, ConverterParameter=AllowZero}" />
                                                    <NumberBox Grid.Column="6" Margin="2,0,6,0" MinWidth="0"
                                                               Minimum="1" SpinButtonPlacementMode="Hidden"
                                                               Value="{Binding DisplayLength, Mode=TwoWay, Converter={StaticResource IntToDouble}}" />
                                                    <NumberBox Grid.Column="7" Margin="2,0,6,0" MinWidth="0"
                                                               Minimum="1" SpinButtonPlacementMode="Hidden"
                                                               Visibility="{Binding IsTextAreaField, Converter={StaticResource BoolToVisibility}}"
                                                               Value="{Binding TextAreaRows, Mode=TwoWay, Converter={StaticResource IntToDouble}}" />
                                                    <TextBlock Grid.Column="7" Text="—" HorizontalAlignment="Center"
                                                               Visibility="{Binding IsTextAreaField, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                                               Style="{ThemeResource CaptionText}" />
                                                    <NumberBox Grid.Column="8" Margin="2,0,6,0" MinWidth="0"
                                                               Minimum="1" SpinButtonPlacementMode="Hidden"
                                                               Visibility="{Binding IsTextAreaField, Converter={StaticResource BoolToVisibility}}"
                                                               Value="{Binding TextAreaColumns, Mode=TwoWay, Converter={StaticResource IntToDouble}}" />
                                                    <TextBlock Grid.Column="8" Text="—" HorizontalAlignment="Center"
                                                               Visibility="{Binding IsTextAreaField, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                                               Style="{ThemeResource CaptionText}" />
                                                    <CheckBox Grid.Column="9" IsChecked="{Binding IsDisabled, Mode=TwoWay}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              AutomationProperties.Name="不可编辑" />
                                                    <Grid Grid.Column="10" Margin="2,0,6,0" ColumnSpacing="5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="14" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="12" Height="12" CornerRadius="6"
                                                                BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1"
                                                                Background="{Binding FontColor, Converter={StaticResource StringToColorBrush}, ConverterParameter=Solid}"
                                                                VerticalAlignment="Center" />
                                                        <ComboBox Grid.Column="1" MinWidth="0"
                                                                  ItemsSource="{Binding AvailableFontColors}"
                                                                  SelectedItem="{Binding FontColorDisplayText, Mode=TwoWay}" />
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="ActionGrid" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ActionHint" Text="写入前会再次确认；未启用覆盖时不会修改同名窗体。"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               Style="{ThemeResource CaptionText}" />
                    <Button x:Name="ApplyButton" Grid.Column="1" Command="{Binding ApplyCommand}"
                            Style="{ThemeResource AccentButton}" Padding="24,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontSize="15" />
                            <TextBlock Text="写入 Aras 窗体" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
