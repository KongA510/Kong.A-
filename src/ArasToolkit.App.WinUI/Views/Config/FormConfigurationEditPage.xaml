<Page
    x:Class="ArasToolkit.App.WinUI.Views.FormConfigurationEditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="Page_SizeChanged">
    <Grid x:Name="EditorWorkspace" Margin="24,16,24,16" RowSpacing="10" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="220" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="窗体配置修改" Style="{ThemeResource PageTitleText}" />
                <TextBlock Text="画布与布局同步编辑 · 详细属性按需切换" Style="{ThemeResource PageSubtitleText}" />
            </StackPanel>
            <ProgressRing Grid.Column="1" Width="28" Height="28" IsActive="{Binding IsBusy}" />
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="ItemTypeSearch" Header="对象类" PlaceholderText="搜索名称或标签"
                            TextChanged="ItemTypeSearch_TextChanged" QuerySubmitted="ItemTypeSearch_QuerySubmitted">
                <AutoSuggestBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
            <ComboBox x:Name="FormPicker" Grid.Column="1" Header="已有窗体" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Forms}" SelectionChanged="FormPicker_SelectionChanged" PlaceholderText="先选择对象类">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox x:Name="BodyPicker" Grid.Column="2" Header="窗体主体" HorizontalAlignment="Stretch" SelectionChanged="BodyPicker_SelectionChanged" />
            <Button Grid.Column="3" Content="刷新" VerticalAlignment="Bottom" Click="Refresh_Click" />
        </Grid>
        <StackPanel Grid.Row="2" Spacing="4">
            <InfoBar IsOpen="{Binding HasError}" Severity="Error" Title="操作未完成" Message="{Binding Error}" IsClosable="False" />
            <TextBlock Text="{Binding Status}" Style="{ThemeResource CaptionText}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SharedSummary}" Style="{ThemeResource CaptionText}" TextWrapping="Wrap" MaxLines="2" />
        </StackPanel>
        <CommandBar Grid.Row="3" DefaultLabelPosition="Right" Background="Transparent">
            <AppBarButton Icon="Add" Label="新增" IsEnabled="{Binding CanEdit}" Click="Add_Click" />
            <AppBarButton Icon="Delete" Label="删除" IsEnabled="{Binding CanDelete}" Click="Delete_Click" />
            <AppBarButton Icon="Undo" Label="撤销" IsEnabled="{Binding CanUndo}" Click="Undo_Click" />
            <AppBarButton Icon="Redo" Label="重做" IsEnabled="{Binding CanRedo}" Click="Redo_Click" />
            <AppBarButton Label="横排对齐" IsEnabled="{Binding CanAlign}" Click="Align_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE8E3;" /></AppBarButton.Icon></AppBarButton>
            <AppBarSeparator />
            <AppBarButton Icon="View" Label="变更摘要" Click="Changes_Click" />
            <AppBarButton Icon="Save" Label="保存修改" IsEnabled="{Binding CanSave}" Click="Save_Click" />
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ToggleButton x:Name="ToolsToggle" Content="工具区" IsChecked="True" Click="ToolsToggle_Click" />
                    <ToggleButton x:Name="EditorToggle" Content="编辑区" IsChecked="True" Click="EditorToggle_Click" />
                    <ComboBox x:Name="ZoomPicker" Width="92" SelectionChanged="ZoomPicker_SelectionChanged" SelectedIndex="2">
                        <ComboBoxItem Content="50%" /><ComboBoxItem Content="75%" /><ComboBoxItem Content="100%" /><ComboBoxItem Content="125%" /><ComboBoxItem Content="150%" /><ComboBoxItem Content="200%" />
                    </ComboBox>
                </StackPanel>
            </CommandBar.Content>
        </CommandBar>
        <Grid x:Name="Workspace" Grid.Row="4" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="225" /><ColumnDefinition Width="*" MinWidth="160" /><ColumnDefinition Width="420" /></Grid.ColumnDefinitions>
            <Border x:Name="ToolsPanel" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="{ThemeResource CardBrush}" Padding="10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="2*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="控件列表" FontWeight="SemiBold" />
                    <TextBox x:Name="FieldSearch" Grid.Row="1" PlaceholderText="搜索控件、隐藏项" TextChanged="FieldSearch_TextChanged" />
                    <ListView x:Name="FieldList" Grid.Row="2" SelectionMode="Multiple" SelectionChanged="FieldList_SelectionChanged">
                        <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" FontSize="12" TextWrapping="Wrap" /></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="3" Text="对象类属性 · 双击或拖入新增" FontSize="12" FontWeight="SemiBold" />
                    <ListView x:Name="PropertyList" Grid.Row="4" SelectionMode="Single" DoubleTapped="PropertyList_DoubleTapped"
                              CanDragItems="True" DragItemsStarting="PropertyList_DragItemsStarting">
                        <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" FontSize="12" TextWrapping="Wrap" /></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="5" Text="基础控件 · 双击或拖入新增" FontSize="12" FontWeight="SemiBold" />
                    <ListView x:Name="ToolboxList" Grid.Row="6" SelectionMode="Single" DoubleTapped="ToolboxList_DoubleTapped"
                              CanDragItems="True" DragItemsStarting="ToolboxList_DragItemsStarting">
                        <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" FontSize="12" /></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <Border Grid.Column="1" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <WebView2 x:Name="CanvasBrowser" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    <Border x:Name="CanvasStatusPanel" Background="{ThemeResource CardBrush}" CornerRadius="8" Padding="16">
                        <StackPanel VerticalAlignment="Center" Spacing="12">
                            <ProgressRing x:Name="CanvasLoading" IsActive="True" Width="28" Height="28" />
                            <TextBlock x:Name="CanvasStatusTitle" Text="正在加载画布" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="CanvasStatusMessage" Text="正在初始化窗体预览组件…" TextWrapping="Wrap" />
                            <Button x:Name="CanvasRetry" Content="重新加载画布" Visibility="Collapsed" Click="CanvasRetry_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Border x:Name="EditorDock" Grid.Column="2" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="{ThemeResource CardBrush}">
                <Grid RowSpacing="10" Padding="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ToggleButton x:Name="LayoutModeButton" Content="布局预览" IsChecked="True" HorizontalAlignment="Stretch" Click="LayoutMode_Click" />
                        <ToggleButton x:Name="InspectorModeButton" Grid.Column="1" Content="详细属性" HorizontalAlignment="Stretch" Click="InspectorMode_Click" />
                    </Grid>
                    <Grid x:Name="LayoutPreviewPanel" Grid.Row="1" RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="字段列已冻结，横向滚动调整各项。" Style="{ThemeResource CaptionText}" TextWrapping="Wrap" />
                        <Grid Grid.Row="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="LayoutPreviewSummary" Text="选择窗体后显示控件。" Style="{ThemeResource CaptionText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <CheckBox x:Name="SelectedOnlyToggle" Grid.Column="1" Content="仅选中" MinWidth="0" Click="SelectedOnly_Click" />
                        </Grid>
                        <ScrollViewer x:Name="LayoutPreviewScroll" Grid.Row="2" HorizontalScrollBarVisibility="Visible" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" ViewChanged="LayoutPreviewScroll_ViewChanged" IsEnabled="{Binding CanEdit}">
                            <Grid x:Name="LayoutPreviewTable">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Border x:Name="LayoutPreviewHeader" Background="{ThemeResource SurfaceBrush}" />
                                <ScrollViewer x:Name="LayoutPreviewBodyScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="LayoutPreviewRows" HorizontalAlignment="Left" />
                                </ScrollViewer>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                    <ScrollViewer x:Name="InspectorScroll" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="Inspector" Padding="2" Spacing="10" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="5" Text="{Binding SelectionSummary}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
    </Grid>
</Page>
