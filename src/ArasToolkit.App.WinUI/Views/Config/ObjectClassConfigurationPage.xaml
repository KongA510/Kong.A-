<Page
    x:Class="ArasToolkit.App.WinUI.Views.ObjectClassConfigurationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="30,24,30,36" MinWidth="1100" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="对象类配置" Style="{ThemeResource PageTitleText}" />
                <TextBlock Text="批量添加对象类权限页签、设定可创建者，以及配置含状态权限的标准四状态生命周期。"
                           Style="{ThemeResource PageSubtitleText}" />
            </StackPanel>

            <Border Style="{ThemeResource SimpleCard}" Padding="16,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE968;" FontSize="16" />
                        <TextBlock Text="{Binding ConnectionText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ProgressRing Grid.Column="1" IsActive="{Binding IsBusy}" Width="22" Height="22" />
                </Grid>
            </Border>

            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                     Title="标准生命周期规则"
                     Message="Preliminary(新建立) → In Review(审核中) → Released(已发行)；In Review 可退回 Preliminary；Preliminary 与 In Review 均可转 Cancel(取消)。全部转换使用下方设定的单一角色。" />
            <InfoBar IsOpen="{Binding HasError}" IsClosable="False" Severity="Error"
                     Title="操作失败" Message="{Binding ErrorMessage}" />
            <InfoBar IsOpen="{Binding HasStatus}" IsClosable="False" Severity="Informational"
                     Title="当前状态" Message="{Binding StatusMessage}" />

            <Border Style="{ThemeResource SimpleCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="420" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="18,16,18,12" Spacing="12">
                        <TextBlock Text="1  查询并选择对象类" Style="{ThemeResource SectionTitleText}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Header="名称或多语标签条件"
                                     Text="{Binding QueryKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="留空查询全部；支持名称、英文、简体、繁体标签" />
                            <Button Grid.Column="1" Content="查询对象类" Command="{Binding QueryCommand}"
                                    Style="{ThemeResource PrimaryButton}" VerticalAlignment="Bottom" Height="34" />
                            <Button Grid.Column="2" Content="全选" Command="{Binding SelectAllCommand}"
                                    VerticalAlignment="Bottom" Height="34" />
                            <Button Grid.Column="3" Content="清空" Command="{Binding ClearSelectionCommand}"
                                    VerticalAlignment="Bottom" Height="34" />
                            <TextBlock Grid.Column="4" Text="{Binding SelectionSummary}" VerticalAlignment="Bottom"
                                       Margin="8,0,0,8" Style="{ThemeResource CaptionText}" />
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,1" Padding="16,10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="155" />
                                <ColumnDefinition Width="155" />
                                <ColumnDefinition Width="155" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="选择" Style="{ThemeResource TableHeaderText}" />
                            <TextBlock Grid.Column="1" Text="对象类名称" Style="{ThemeResource TableHeaderText}" />
                            <TextBlock Grid.Column="2" Text="英文标签 (en)" Style="{ThemeResource TableHeaderText}" />
                            <TextBlock Grid.Column="3" Text="简体标签 (zc)" Style="{ThemeResource TableHeaderText}" />
                            <TextBlock Grid.Column="4" Text="繁体标签 (zt)" Style="{ThemeResource TableHeaderText}" />
                            <TextBlock Grid.Column="5" Text="当前默认权限" Style="{ThemeResource TableHeaderText}" />
                            <TextBlock Grid.Column="6" Text="执行结果" Style="{ThemeResource TableHeaderText}" />
                        </Grid>
                    </Border>

                    <ListView Grid.Row="2" ItemsSource="{Binding ItemTypes}"
                              Style="{ThemeResource TableListView}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,9" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="155" />
                                            <ColumnDefinition Width="155" />
                                            <ColumnDefinition Width="155" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Click="SelectionCheckBox_Click" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{ThemeResource TableCellText}" />
                                        <TextBlock Grid.Column="2" Text="{Binding LabelEn}" Style="{ThemeResource TableCellText}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="3" Text="{Binding LabelZc}" Style="{ThemeResource TableCellText}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="4" Text="{Binding LabelZt}" Style="{ThemeResource TableCellText}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="5" Text="{Binding DefaultPermissionName}" Style="{ThemeResource TableCellText}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="6" Text="{Binding OperationSummary}" Style="{ThemeResource TableCellText}"
                                                   TextWrapping="Wrap" Foreground="{ThemeResource AccentBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Style="{ThemeResource SimpleCard}">
                <StackPanel Spacing="14">
                    <TextBlock Text="2  选择一键基础设定" Style="{ThemeResource SectionTitleText}" />
                    <StackPanel Orientation="Horizontal" Spacing="30">
                        <CheckBox Content="添加到权限页签" IsChecked="{Binding Options.ConfigureDefaultPermission, Mode=TwoWay}" />
                        <CheckBox Content="可创建者设定" IsChecked="{Binding Options.ConfigureCanAdd, Mode=TwoWay}" />
                        <CheckBox Content="生命周期与状态权限设定" IsChecked="{Binding Options.ConfigureLifecycle, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock Text="创建或复用同名 Permission 并添加到 Allowed Permission 页签，不直接设为默认值；同名生命周期会补齐四个状态权限。"
                               Style="{ThemeResource CaptionText}" />
                </StackPanel>
            </Border>

            <Border Style="{ThemeResource SimpleCard}">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="3  角色模板" Style="{ThemeResource SectionTitleText}" />
                        <Button Grid.Column="1" Content="恢复默认" Command="{Binding ResetSettingsCommand}" Margin="0,0,8,0" />
                        <Button Grid.Column="2" Content="保存角色配置" Command="{Binding SaveSettingsCommand}"
                                Style="{ThemeResource PrimaryButton}" />
                    </Grid>

                    <Grid ColumnSpacing="14" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Grid.Row="0" Grid.Column="0" Header="新增状态完整权限角色"
                                 Text="{Binding Settings.CreatorFullControlRoles, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Creator" />
                        <TextBox Grid.Row="0" Grid.Column="1" Header="一般只读/可查角色"
                                 Text="{Binding Settings.ReadOnlyRoles, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="World,Owner,Manager" />
                        <TextBox Grid.Row="1" Grid.Column="0" Header="管理员完整权限角色"
                                 Text="{Binding Settings.AdministratorFullControlRoles, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Aras PLM,Administrator,Innovator Admin" />
                        <TextBox Grid.Row="1" Grid.Column="1" Header="可创建者角色"
                                 Text="{Binding Settings.CanAddRoles, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="World" />
                        <TextBox Grid.Row="2" Grid.Column="0" Header="生命周期转换角色（仅一个）"
                                 Text="{Binding Settings.TransitionRole, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Aras PLM" />
                        <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                   Text="多个角色请用逗号分隔。非 Preliminary 状态中，只有管理员角色保留编辑/删除权限，其余角色仅可读、可查。"
                                   TextWrapping="Wrap" Style="{ThemeResource CaptionText}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{ThemeResource SimpleCard}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="6">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercentage}"
                                     IsIndeterminate="{Binding IsProgressIndeterminate}" Height="4" />
                        <TextBlock Text="{Binding ProgressText}" Style="{ThemeResource CaptionText}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="取消" Command="{Binding CancelCommand}" />
                    <Button Grid.Column="2" Content="一键设定基础设定" Command="{Binding ExecuteCommand}"
                            Style="{ThemeResource PrimaryButton}" Padding="18,8" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
