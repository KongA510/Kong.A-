<Page
    x:Class="ArasToolkit.App.WinUI.Views.PackageMigrationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled">
    <Grid Margin="24,18,24,16" RowSpacing="12" MinWidth="920">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="620" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Text="导包工具" Style="{ThemeResource PageTitleText}" />
                <TextBlock Text="勾选配置与依赖，将经过比较的 AML 包迁入目标系统。" Style="{ThemeResource CaptionText}" />
            </StackPanel>
            <Border Grid.Column="1" Background="{ThemeResource SurfaceBrush}" CornerRadius="8" Padding="16,10" VerticalAlignment="Center">
                <TextBlock Text="{Binding Direction}" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource AccentBrush}" />
            </Border>
        </Grid>
        <Pivot Grid.Row="1" SelectedIndex="{Binding ModeIndex, Mode=TwoWay}">
            <PivotItem Header="快速迁移" /><PivotItem Header="导出包" /><PivotItem Header="导入包" /><PivotItem Header="执行历史" />
        </Pivot>
        <Border Grid.Row="2" Style="{ThemeResource SimpleCard}" Padding="14" Visibility="{Binding IsWorkspace, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="源系统" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding Connections}" SelectedItem="{Binding Source, Mode=TwoWay}" HorizontalAlignment="Stretch" IsEnabled="{Binding CanChooseSource}">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding SourceVersion}" Style="{ThemeResource CaptionText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="目标系统" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding Connections}" SelectedItem="{Binding Target, Mode=TwoWay}" HorizontalAlignment="Stretch" IsEnabled="{Binding IsIdle}">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding TargetVersion}" Style="{ThemeResource CaptionText}" />
                    </StackPanel>
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding EngineDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="官方导包工具目录" AutomationProperties.Name="官方导包工具目录" IsEnabled="{Binding IsIdle}" />
                    <Button Grid.Column="1" Content="选择工具" Command="{Binding BrowseEngineCommand}" />
                    <Button Grid.Column="2" Content="检查工具" Command="{Binding ProbeCommand}" />
                </Grid>
                <TextBlock Text="{Binding EngineStatus}" Style="{ThemeResource CaptionText}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="3" ColumnSpacing="14" Visibility="{Binding IsWorkspace, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{ThemeResource SimpleCard}" Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="110" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="选择配置" FontSize="17" FontWeight="SemiBold" />
                    <ComboBox Grid.Row="1" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType, Mode=TwoWay}" HorizontalAlignment="Stretch" IsEnabled="{Binding CanChooseSource}" />
                    <Grid Grid.Row="2" ColumnSpacing="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="按配置名称查找" IsEnabled="{Binding CanChooseSource}" />
                        <Button Grid.Column="1" Content="查找" Command="{Binding SearchCommand}" />
                    </Grid>
                    <ListView Grid.Row="3" ItemsSource="{Binding Catalog}" SelectionMode="None" MinHeight="100" IsEnabled="{Binding IsIdle}">
                        <ListView.ItemTemplate><DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Padding="0,5">
                                <StackPanel Spacing="2"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /><TextBlock Text="{Binding Label}" Style="{ThemeResource CaptionText}" TextWrapping="Wrap" /></StackPanel>
                            </CheckBox>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="4" Text="已选清单 · 可跨类型补选" FontWeight="SemiBold" />
                    <ListView Grid.Row="5" ItemsSource="{Binding SelectedRoots}" SelectionMode="None" IsEnabled="{Binding IsIdle}">
                        <ListView.ItemTemplate><DataTemplate>
                            <Grid ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="×" Tag="{Binding}" Click="RemoveSelection_Click" Padding="6,2" AutomationProperties.Name="移出清单" />
                            </Grid>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="6" Spacing="6">
                        <Button Content="分析依赖" Command="{Binding AnalyzeCommand}" HorizontalAlignment="Stretch" />
                        <Button Content="导出 ZIP 包" Command="{Binding ExportCommand}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="1" RowSpacing="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SelectionSummary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="载入 .mf / ZIP" Command="{Binding OpenPackageCommand}" />
                </Grid>
                <Border Grid.Row="1" Style="{ThemeResource SimpleCard}" Padding="12">
                    <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="依赖树" FontSize="16" FontWeight="SemiBold" />
                        <TreeView x:Name="DependencyTree" Grid.Row="1" SelectionMode="None" MinHeight="100" />
                    </Grid>
                </Border>
                <Border Grid.Row="2" Style="{ThemeResource SimpleCard}" Padding="12">
                    <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="目标差异 · 勾选需要迁入的项目" FontSize="16" FontWeight="SemiBold" />
                        <ListView Grid.Row="1" ItemsSource="{Binding Differences}" SelectedItem="{Binding SelectedDifference, Mode=TwoWay}" MinHeight="100" IsEnabled="{Binding IsIdle}">
                            <ListView.ItemTemplate><DataTemplate>
                                <CheckBox IsChecked="{Binding Include, Mode=TwoWay}" Padding="0,4"><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" /></CheckBox>
                            </DataTemplate></ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="3" Spacing="6">
                    <TextBlock Text="{Binding PackagePath}" Style="{ThemeResource CaptionText}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="生成 AML 并比较" Command="{Binding PrepareCommand}" />
                        <Button Content="重新比较" Command="{Binding CompareCommand}" />
                        <Button Content="备份并迁入" Command="{Binding ExecuteCommand}" Style="{ThemeResource PrimaryButton}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
        <Grid Grid.Row="3" RowSpacing="10" Visibility="{Binding IsHistory, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Button Content="刷新执行历史" Command="{Binding RefreshHistoryCommand}" />
            <ListView Grid.Row="1" ItemsSource="{Binding History}" SelectionMode="None">
                <ListView.ItemTemplate><DataTemplate>
                    <Grid Padding="8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Message}" TextWrapping="Wrap" /><TextBlock Text="{Binding Directory}" Style="{ThemeResource CaptionText}" /></StackPanel>
                        <Button Grid.Column="1" Content="查看记录与备份" Tag="{Binding}" Click="OpenHistory_Click" />
                    </Grid>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>
        </Grid>
        <StackPanel Grid.Row="4" Spacing="6">
            <Expander Header="差异详情与依赖说明" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <ScrollViewer MaxHeight="220"><StackPanel Spacing="10"><TextBlock Text="{Binding IssuesText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" /><TextBlock Text="{Binding Details}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Consolas" FontSize="12" /></StackPanel></ScrollViewer>
            </Expander>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{ThemeResource ErrorBrush}" TextWrapping="Wrap" />
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Height="3" />
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Style="{ThemeResource CaptionText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="取消操作" Command="{Binding CancelCommand}" />
            </Grid>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Page>
