<Page
    x:Class="ArasToolkit.App.WinUI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24,32,36" Spacing="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="仪表盘" Style="{ThemeResource PageTitleText}" />
                        <TextBlock Text="Aras 开发工具箱概览与全部功能入口"
                                   Style="{ThemeResource PageSubtitleText}" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding RefreshCommand}"
                            Style="{ThemeResource FluentButton}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="刷新状态" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Style="{ThemeResource SimpleCard}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="21"
                                Background="{Binding ConnectionStatus, Converter={StaticResource ConnectionStatusToBrush}}">
                            <FontIcon Glyph="&#xE774;" FontSize="18" Foreground="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Aras Innovator 连接" Style="{ThemeResource SectionTitleText}" />
                            <TextBlock Text="连接后可使用窗体、对象类、属性、翻译与数据汇入功能。"
                                       Style="{ThemeResource CaptionText}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding ConnectionStatus}"
                                   FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{Binding ConnectionStatus, Converter={StaticResource ConnectionStatusToBrush}}" />
                    </Grid>
                </Border>

                <StackPanel Spacing="10">
                    <TextBlock Text="Aras 连接详情" Style="{ThemeResource SectionTitleText}" />
                    <GridView ItemsSource="{Binding ArasMetrics}" SelectionMode="None" IsItemClickEnabled="False">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="0,0,12,12" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Border Width="230" Style="{ThemeResource SimpleCard}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{Binding Icon}" FontSize="18"
                                                  Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{Binding Value}" FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Label}" Style="{ThemeResource CaptionText}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="当前用户" Style="{ThemeResource SectionTitleText}" />
                    <GridView ItemsSource="{Binding UserMetrics}" SelectionMode="None" IsItemClickEnabled="False">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="0,0,12,12" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Border Width="230" Style="{ThemeResource SimpleCard}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{Binding Icon}" FontSize="18"
                                                  Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{Binding Value}" FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Label}" Style="{ThemeResource CaptionText}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="全部功能" Style="{ThemeResource SectionTitleText}" />
                    <GridView ItemsSource="{Binding AllFeatures}"
                              IsItemClickEnabled="True"
                              SelectionMode="None"
                              ItemClick="FeatureGrid_ItemClick">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="0,0,12,12" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="CornerRadius" Value="12" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Border Width="260" MinHeight="126" Style="{ThemeResource SimpleCard}">
                                    <Grid RowSpacing="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="8"
                                                    Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                                <FontIcon Glyph="{Binding Icon}" FontSize="17"
                                                          FontFamily="Segoe Fluent Icons"
                                                          Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <FontIcon Grid.Column="2" Glyph="&#xE72A;" FontSize="12"
                                                      Foreground="{ThemeResource TextSecondaryBrush}"
                                                      VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding Description}"
                                                   Style="{ThemeResource CaptionText}" TextWrapping="Wrap"
                                                   TextTrimming="None" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
