<Page
    x:Class="ArasToolkit.App.WinUI.Views.ArasTranslationLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="30,24,30,26" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="210" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Aras 翻译日志" Style="{ThemeResource PageTitleText}" />
                <TextBlock Text="字段、表单、窗体在线翻译任务与逐项写回记录；文本翻译历史保持独立。"
                           Style="{ThemeResource PageSubtitleText}" />
            </StackPanel>
            <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}"
                    Style="{ThemeResource PrimaryButton}" VerticalAlignment="Bottom" Height="34" />
        </Grid>

        <Border Grid.Row="1" Style="{ThemeResource SimpleCard}" Padding="16,12">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" Header="翻译类型" ItemsSource="{Binding TaskTypes}"
                          SelectedItem="{Binding SelectedTaskType, Mode=TwoWay}" />
                <ComboBox Grid.Column="1" Header="任务状态" ItemsSource="{Binding Statuses}"
                          SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" />
                <TextBox Grid.Column="2" Header="关键字" Text="{Binding SearchText, Mode=TwoWay}"
                         PlaceholderText="任务名或对象范围" />
                <Button Grid.Column="3" Content="筛选" Command="{Binding ApplyFilterCommand}"
                        Style="{ThemeResource PrimaryButton}" VerticalAlignment="Bottom" Height="34" />
                <Button Grid.Column="4" Content="重置" Command="{Binding ClearFilterCommand}"
                        VerticalAlignment="Bottom" Height="34" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{ThemeResource SimpleCard}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="类型" Style="{ThemeResource TableHeaderText}" />
                        <TextBlock Grid.Column="1" Text="任务名称" Style="{ThemeResource TableHeaderText}" />
                        <TextBlock Grid.Column="2" Text="状态" Style="{ThemeResource TableHeaderText}" />
                        <TextBlock Grid.Column="3" Text="源语言" Style="{ThemeResource TableHeaderText}" />
                        <TextBlock Grid.Column="4" Text="目标语言" Style="{ThemeResource TableHeaderText}" />
                        <TextBlock Grid.Column="5" Text="完成" Style="{ThemeResource TableHeaderText}" />
                        <TextBlock Grid.Column="6" Text="创建时间" Style="{ThemeResource TableHeaderText}" />
                    </Grid>
                </Border>
                <ListView Grid.Row="1" ItemsSource="{Binding Tasks}"
                          SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                          SelectionMode="Single" Style="{ThemeResource TableListView}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16,10" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="105" />
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TaskType}" Style="{ThemeResource TableCellText}" />
                                    <TextBlock Grid.Column="1" Text="{Binding TaskName}" Style="{ThemeResource TableCellText}" />
                                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" Style="{ThemeResource TableCellText}" />
                                    <TextBlock Grid.Column="3" Text="{Binding SourceLanguage}" Style="{ThemeResource TableCellText}" />
                                    <TextBlock Grid.Column="4" Text="{Binding TargetLanguages}" Style="{ThemeResource TableCellText}" />
                                    <TextBlock Grid.Column="5" Text="{Binding CompletionText}" Style="{ThemeResource TableCellText}" />
                                    <TextBlock Grid.Column="6" Text="{Binding DisplayCreatedAt}" Style="{ThemeResource TableCellText}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ProgressRing IsActive="{Binding IsLoading}" Width="36" Height="36"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="{Binding PageInfo}" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button Content="&#xE892;" FontFamily="Segoe Fluent Icons" Command="{Binding FirstPageCommand}"
                        Style="{ThemeResource PagingButton}" />
                <Button Content="&#xE76B;" FontFamily="Segoe Fluent Icons" Command="{Binding PreviousPageCommand}"
                        Style="{ThemeResource PagingButton}" />
                <Button Content="&#xE76C;" FontFamily="Segoe Fluent Icons" Command="{Binding NextPageCommand}"
                        Style="{ThemeResource PagingButton}" />
                <Button Content="&#xE893;" FontFamily="Segoe Fluent Icons" Command="{Binding LastPageCommand}"
                        Style="{ThemeResource PagingButton}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="4" Style="{ThemeResource SimpleCard}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding SelectedTaskTitle}" FontSize="15" FontWeight="SemiBold"
                           Padding="16,12" />
                <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,1" Padding="16,9">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="字段 / 控件" Style="{ThemeResource TableHeaderText}" />
                        <TextBlock Grid.Column="1" Text="原文" Style="{ThemeResource TableHeaderText}" />
                        <TextBlock Grid.Column="2" Text="译文" Style="{ThemeResource TableHeaderText}" />
                        <TextBlock Grid.Column="3" Text="目标语言" Style="{ThemeResource TableHeaderText}" />
                        <TextBlock Grid.Column="4" Text="记录时间" Style="{ThemeResource TableHeaderText}" />
                    </Grid>
                </Border>
                <ListView Grid.Row="2" ItemsSource="{Binding Records}" Style="{ThemeResource TableListView}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16,9" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding FieldName}" Style="{ThemeResource TableCellText}" />
                                    <TextBlock Grid.Column="1" Text="{Binding OriginalLabel}" Style="{ThemeResource TableCellText}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="2" Text="{Binding TranslatedLabel}" Style="{ThemeResource TableCellText}"
                                               Foreground="{ThemeResource AccentBrush}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="3" Text="{Binding TargetLanguage}" Style="{ThemeResource TableCellText}" />
                                    <TextBlock Grid.Column="4" Text="{Binding DisplayCreatedAt}" Style="{ThemeResource TableCellText}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
