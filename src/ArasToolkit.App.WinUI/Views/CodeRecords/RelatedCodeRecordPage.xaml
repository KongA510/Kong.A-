<Page
    x:Class="ArasToolkit.App.WinUI.Views.RelatedCodeRecordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="Page_SizeChanged">

    <Page.Resources>
        <Style x:Key="WorkspacePanelStyle" TargetType="Border" BasedOn="{StaticResource SimpleCard}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="NavigatorItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="PanelStepStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource AccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid Margin="32,24,32,32" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="相关代码记录" Style="{ThemeResource PageTitleText}" />
                <TextBlock Text="先选主题，再从标题与用途目录中打开需要的代码段。"
                           Style="{ThemeResource PageSubtitleText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <ProgressRing IsActive="{Binding IsBusy}" Width="22" Height="22" Margin="0,0,4,0" />
                <Button Content="刷新" Command="{Binding RefreshCommand}" Height="34" />
                <Button Content="编辑主题" Command="{Binding EditRecordCommand}" Height="34" />
                <Button Content="新建主题" Command="{Binding NewRecordCommand}"
                        Style="{ThemeResource PrimaryButton}" Height="34" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="6">
            <InfoBar IsOpen="{Binding HasError}" IsClosable="False" Severity="Error"
                     Title="操作失败" Message="{Binding ErrorMessage}" />
            <TextBlock Text="{Binding StatusMessage}" Style="{ThemeResource CaptionText}"
                       TextTrimming="CharacterEllipsis" MaxLines="1" />
        </StackPanel>

        <Grid x:Name="WorkspaceGrid" Grid.Row="2" ColumnSpacing="12" RowSpacing="12" MinHeight="560">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="0" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>

            <!-- 第一级：主题 -->
            <Border x:Name="ThemePanel" Style="{StaticResource WorkspacePanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="16,14" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="01" Style="{StaticResource PanelStepStyle}" />
                        <TextBlock Grid.Column="1" Text="主题" Style="{ThemeResource SectionTitleText}" />
                        <TextBlock Grid.Column="2" Text="{Binding LibrarySummary}"
                                   Style="{ThemeResource CaptionText}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1" Padding="12,0,12,10" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="搜索主题或代码" KeyDown="SearchBox_KeyDown" />
                        <Button Grid.Column="1" Content="查询" Click="SearchButton_Click"
                                Style="{ThemeResource PrimaryButton}" />
                    </Grid>
                    <ListView Grid.Row="2" ItemsSource="{Binding Records}"
                              SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                              SelectionMode="Single" ItemContainerStyle="{StaticResource NavigatorItemStyle}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12,10" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{ThemeResource AccentBrush}" CornerRadius="2" />
                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DisplayCreatorOn}" Style="{ThemeResource CaptionText}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- 第二级：代码段标题与用途说明 -->
            <Border x:Name="SegmentPanel" Grid.Column="1" Style="{StaticResource WorkspacePanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="16,14,12,4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="02" Style="{StaticResource PanelStepStyle}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="标题 / 用途" Style="{ThemeResource SectionTitleText}" />
                            <TextBlock Text="{Binding Title}" Style="{ThemeResource CaptionText}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="新增" Command="{Binding NewSegmentCommand}"
                                Style="{ThemeResource CompactButton}" VerticalAlignment="Top" />
                    </Grid>
                    <Grid Grid.Row="1" Padding="16,4,16,10" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="单击查看用途，双击打开具体代码"
                                   Style="{ThemeResource CaptionText}" />
                        <TextBlock Grid.Column="1" Text="{Binding SegmentSummary}"
                                   Style="{ThemeResource CaptionText}" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <ListView x:Name="SegmentMenuList" ItemsSource="{Binding Segments}"
                                  SelectedItem="{Binding SelectedSegment, Mode=TwoWay}"
                                  SelectionMode="Single" ItemContainerStyle="{StaticResource NavigatorItemStyle}"
                                  DoubleTapped="SegmentMenuList_DoubleTapped"
                                  KeyDown="SegmentMenuList_KeyDown"
                                  Visibility="{Binding HasSegments, Converter={StaticResource BoolToVisibility}}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12,10" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{Binding CodeType, Converter={StaticResource CodeTypeToBrush}}"
                                                CornerRadius="2" />
                                        <StackPanel Grid.Column="1" Spacing="7">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Padding="7,2" CornerRadius="4"
                                                        Background="{Binding CodeType, Converter={StaticResource CodeTypeToBrush}, ConverterParameter=Background}">
                                                    <TextBlock Text="{Binding CodeType}" FontFamily="Cascadia Mono, Consolas"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding CodeType, Converter={StaticResource CodeTypeToBrush}}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding SegmentName}"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                            <TextBlock Text="{Binding DisplayDescription}" MaxLines="3"
                                                       TextWrapping="Wrap" FontSize="12"
                                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7"
                                    Visibility="{Binding HasSegments, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <TextBlock Text="[ ]" FontFamily="Cascadia Mono, Consolas" FontSize="26"
                                       Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="暂无代码段" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="选择主题后，可在这里新增代码标题与用途。"
                                       Style="{ThemeResource CaptionText}" TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 第三级：具体代码阅读区，以及按需展开的编辑器 -->
            <Border x:Name="CodePanel" Grid.Column="2" Style="{StaticResource WorkspacePanelStyle}">
                <Grid>
                    <Grid Visibility="{Binding IsCodeWorkspaceVisible, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Padding="16,14" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="03" Style="{StaticResource PanelStepStyle}" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="具体代码" Style="{ThemeResource SectionTitleText}" />
                                <TextBlock Text="双击中间的标题与用途菜单后显示"
                                           Style="{ThemeResource CaptionText}" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <StackPanel Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                        Visibility="{Binding HasOpenedSegment, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                <TextBlock Text="&lt;/&gt;" FontFamily="Cascadia Mono, Consolas" FontSize="34"
                                           Foreground="{ThemeResource AccentBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="双击一个代码段" FontSize="16" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="先在左侧选择主题，再双击中间的标题，即可在这里阅读具体代码。"
                                           Style="{ThemeResource CaptionText}" TextAlignment="Center"
                                           TextWrapping="Wrap" MaxWidth="360" />
                            </StackPanel>
                            <ScrollViewer x:Name="CodeScrollViewer"
                                          Visibility="{Binding HasOpenedSegment, Converter={StaticResource BoolToVisibility}}"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Padding="16,4,16,16" Spacing="12">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Padding="8,3" CornerRadius="5" VerticalAlignment="Top"
                                                Background="{Binding OpenedSegment.CodeType, Converter={StaticResource CodeTypeToBrush}, ConverterParameter=Background}">
                                            <TextBlock Text="{Binding OpenedSegment.CodeType}" FontFamily="Cascadia Mono, Consolas"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding OpenedSegment.CodeType, Converter={StaticResource CodeTypeToBrush}}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{Binding OpenedSegment.SegmentName}" FontSize="18"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding OpenedSegment.DisplayCreatorOn}"
                                                       Style="{ThemeResource CaptionText}" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Background="{ThemeResource SystemListLowBrush}"
                                            BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="14,12">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="用途说明" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding OpenedSegment.DisplayDescription}" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="代码内容" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Button Content="↑" Tag="{Binding OpenedSegment}" Click="MoveUpButton_Click"
                                                    Style="{ThemeResource CompactButton}" ToolTipService.ToolTip="上移代码段" />
                                            <Button Content="↓" Tag="{Binding OpenedSegment}" Click="MoveDownButton_Click"
                                                    Style="{ThemeResource CompactButton}" ToolTipService.ToolTip="下移代码段" />
                                            <Button Content="编辑" Tag="{Binding OpenedSegment}" Click="EditSegmentButton_Click"
                                                    Style="{ThemeResource CompactButton}" />
                                            <Button Content="复制" Tag="{Binding OpenedSegment}" Click="CopySegmentButton_Click"
                                                    Style="{ThemeResource CompactButton}" />
                                            <Button Content="删除" Tag="{Binding OpenedSegment}" Click="DeleteSegmentButton_Click"
                                                    Style="{ThemeResource CompactButton}" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Background="{ThemeResource SystemListLowBrush}"
                                            BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="14,12" MinHeight="360">
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Disabled">
                                            <RichTextBlock x:Name="OpenedSegmentCode"
                                                           FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                                           TextWrapping="NoWrap" IsTextSelectionEnabled="True" />
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <ScrollViewer Visibility="{Binding IsRecordEditorVisible, Converter={StaticResource BoolToVisibility}}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Padding="18,16" Spacing="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding RecordEditorTitle}" Style="{ThemeResource SectionTitleText}" />
                                    <TextBlock Text="主题用于归集同一业务场景下的代码链路。"
                                               Style="{ThemeResource CaptionText}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="关闭" Command="{Binding CancelRecordCommand}"
                                        Style="{ThemeResource CompactButton}" />
                            </Grid>
                            <TextBox Header="主题标题"
                                     Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="200" PlaceholderText="例如：Part 创建后的前后端处理链路" />
                            <TextBox Header="主题说明"
                                     Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110"
                                     PlaceholderText="说明业务场景、调用顺序和注意事项" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="删除主题" Command="{Binding DeleteRecordCommand}" />
                                <Button Content="保存主题" Command="{Binding SaveRecordCommand}"
                                        Style="{ThemeResource AccentButton}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer Visibility="{Binding IsSegmentEditorVisible, Converter={StaticResource BoolToVisibility}}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Padding="18,16" Spacing="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding SegmentEditorTitle}" Style="{ThemeResource SectionTitleText}" />
                                    <TextBlock Text="保存后将出现在中间的标题与用途目录中。"
                                               Style="{ThemeResource CaptionText}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="关闭" Command="{Binding CancelSegmentCommand}"
                                        Style="{ThemeResource CompactButton}" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBox Header="代码段标题"
                                         Text="{Binding SegmentName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="200" PlaceholderText="例如：服务端权限提升" />
                                <ComboBox Grid.Column="1" Header="代码类型" ItemsSource="{Binding CodeTypes}"
                                          SelectedItem="{Binding SelectedCodeType, Mode=TwoWay}" />
                            </Grid>
                            <TextBox Header="用途说明"
                                     Text="{Binding SegmentDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="76"
                                     PlaceholderText="说明该段代码的职责、输入输出或调用位置" />
                            <TextBlock Text="代码内容" FontWeight="SemiBold" />
                            <TextBox x:Name="CodeEditor"
                                     Text="{Binding CodeContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono, Consolas"
                                     FontSize="12.5" Padding="12,10" MinHeight="280" IsSpellCheckEnabled="False"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="高亮预览" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="实时预览 · 200ms"
                                           Style="{ThemeResource CaptionText}" />
                            </Grid>
                            <Border Background="{ThemeResource SystemListLowBrush}"
                                    BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,10" MinHeight="240">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto" MaxHeight="340">
                                    <RichTextBlock x:Name="EditorPreview" FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="12.5" TextWrapping="NoWrap"
                                                   IsTextSelectionEnabled="True" />
                                </ScrollViewer>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="取消" Command="{Binding CancelSegmentCommand}" />
                                <Button Content="保存代码段" Command="{Binding SaveSegmentCommand}"
                                        Style="{ThemeResource AccentButton}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
