<Page
    x:Class="ArasToolkit.App.WinUI.Views.DataToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="Page_SizeChanged">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,24,30,36" Spacing="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Title}" Style="{ThemeResource PageTitleText}" />
                        <TextBlock Text="{Binding Subtitle}" Style="{ThemeResource PageSubtitleText}" MaxWidth="920"
                                   HorizontalAlignment="Left" />
                    </StackPanel>
                    <Border Grid.Column="1" Padding="10,5" CornerRadius="6"
                            Background="{ThemeResource AccentFillColorSecondaryBrush}"
                            VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE943;" FontSize="13"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            <TextBlock Text="本地解析 · 数据不外传" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 格式化与实体转换：统一的左输入 / 右输出工作台。 -->
                <StackPanel x:Name="TransformPanel" Spacing="12"
                            Visibility="{Binding IsTransformMode, Converter={StaticResource BoolToVisibility}}">
                    <Grid Visibility="{Binding IsJsonToEntity, Converter={StaticResource BoolToVisibility}}">
                        <TextBox Width="260" HorizontalAlignment="Left" Header="根实体类名"
                                 Text="{Binding RootClassName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="RootEntity" />
                    </Grid>

                    <Grid x:Name="TransformGrid" ColumnSpacing="14" RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="TransformInputCard" Style="{ThemeResource SimpleCard}" Padding="16">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding InputLabel}" Style="{ThemeResource SectionTitleText}" />
                                    <TextBlock Grid.Column="1" Text="INPUT" FontSize="10" FontWeight="SemiBold"
                                               CharacterSpacing="120" Foreground="{ThemeResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <TextBox x:Name="TransformInputEditor"
                                         Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="{Binding InputPlaceholder}"
                                         AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas"
                                         FontSize="13" MinHeight="380"
                                         IsSpellCheckEnabled="False" HorizontalAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="TransformOutputCard" Grid.Column="1"
                                Style="{ThemeResource SimpleCard}" Padding="16">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding OutputLabel}" Style="{ThemeResource SectionTitleText}" />
                                    <Button Grid.Column="1" Content="复制结果" Style="{ThemeResource CompactButton}"
                                            Click="CopyOutput_Click" />
                                </Grid>
                                <TextBox x:Name="TransformOutputEditor"
                                         Text="{Binding OutputText, Mode=OneWay}"
                                         AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas"
                                         FontSize="13" MinHeight="380" IsReadOnly="True"
                                         IsSpellCheckEnabled="False" HorizontalAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="{Binding PrimaryActionText}" Command="{Binding ExecuteCommand}"
                                Style="{ThemeResource PrimaryButton}" />
                        <Button Content="清空" Command="{Binding ClearCommand}" />
                        <ProgressRing Width="22" Height="22" IsActive="{Binding IsBusy}"
                                      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>

                <!-- XML / JSON 比对工作台。 -->
                <StackPanel x:Name="ComparePanel" Spacing="12"
                            Visibility="{Binding IsCompareMode, Converter={StaticResource BoolToVisibility}}">
                    <Grid x:Name="CompareInputGrid" ColumnSpacing="14" RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="CompareLeftCard" Style="{ThemeResource SimpleCard}" Padding="16">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding LeftLabel}" Style="{ThemeResource SectionTitleText}" />
                                    <TextBlock Grid.Column="1" Text="A" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <TextBox x:Name="CompareLeftEditor"
                                         Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas"
                                         FontSize="13" MinHeight="270" IsSpellCheckEnabled="False"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="CompareRightCard" Grid.Column="1"
                                Style="{ThemeResource SimpleCard}" Padding="16">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding RightLabel}" Style="{ThemeResource SectionTitleText}" />
                                    <TextBlock Grid.Column="1" Text="B" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <TextBox x:Name="CompareRightEditor"
                                         Text="{Binding SecondInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas"
                                         FontSize="13" MinHeight="270" IsSpellCheckEnabled="False"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="{Binding PrimaryActionText}" Command="{Binding ExecuteCommand}"
                                Style="{ThemeResource PrimaryButton}" />
                        <Button Content="交换 A / B" Command="{Binding SwapCommand}" />
                        <Button Content="清空" Command="{Binding ClearCommand}" />
                        <ProgressRing Width="22" Height="22" IsActive="{Binding IsBusy}"
                                      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <Border Style="{ThemeResource SimpleCard}" Padding="0"
                            Visibility="{Binding HasComparisonResult, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Padding="16,14" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="差异结果" Style="{ThemeResource SectionTitleText}" />
                                    <TextBlock Text="{Binding ComparisonSummary}" Style="{ThemeResource CaptionText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Width="10" Height="10" CornerRadius="5" Background="#DC2626" />
                                        <TextBlock Text="B 中缺少" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Width="10" Height="10" CornerRadius="5" Background="#CA8A04" />
                                        <TextBlock Text="内容差异" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Width="10" Height="10" CornerRadius="5" Background="#EA580C" />
                                        <TextBlock Text="A 中缺少" FontSize="12" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,1"
                                  Padding="0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="#" Style="{ThemeResource TableHeaderText}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="A（归一化后）" Style="{ThemeResource TableHeaderText}" />
                                <TextBlock Grid.Column="2" Text="差异" Style="{ThemeResource TableHeaderText}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="#" Style="{ThemeResource TableHeaderText}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="B（归一化后）" Style="{ThemeResource TableHeaderText}" />
                            </Grid>

                            <ListView Grid.Row="2" ItemsSource="{Binding DiffLines}" Style="{ThemeResource TableListView}"
                                      MaxHeight="560" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="30" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{Binding LeftKind, Converter={StaticResource DiffKindToBrush}}">
                                                <TextBlock Text="{Binding LeftLineNumber}" FontFamily="Consolas" FontSize="11"
                                                           Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Border Grid.Column="1" Padding="8,6"
                                                    Background="{Binding LeftKind, Converter={StaticResource DiffKindToBrush}}">
                                                <TextBlock Text="{Binding LeftText}" FontFamily="Consolas" FontSize="12"
                                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </Border>
                                            <Border Grid.Column="2" Background="{Binding Kind, Converter={StaticResource DiffKindToBrush}}">
                                                <TextBlock Text="{Binding KindLabel}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{Binding Kind, Converter={StaticResource DiffKindToBrush}, ConverterParameter=Solid}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border Grid.Column="3" Background="{Binding RightKind, Converter={StaticResource DiffKindToBrush}}">
                                                <TextBlock Text="{Binding RightLineNumber}" FontFamily="Consolas" FontSize="11"
                                                           Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Border Grid.Column="4" Padding="8,6"
                                                    Background="{Binding RightKind, Converter={StaticResource DiffKindToBrush}}">
                                                <TextBlock Text="{Binding RightText}" FontFamily="Consolas" FontSize="12"
                                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock Grid.Row="3" Margin="16,10" Style="{ThemeResource CaptionText}"
                                       Text="红色：A 有而 B 缺少 · 黄色：同一位置内容不同 · 橙色：B 有而 A 缺少" />
                        </Grid>
                    </Border>
                </StackPanel>

                <InfoBar IsOpen="{Binding HasStatus}" IsClosable="False" Severity="Informational"
                         Message="{Binding StatusMessage}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
