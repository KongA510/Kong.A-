<Page
    x:Class="ArasToolkit.App.WinUI.Views.ProjectPlanImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock Text="汇入项目计划模板" FontSize="24" FontWeight="Bold"
                       Foreground="{ThemeResource TextPrimaryBrush}" />
            <TextBlock Text="按照下载模板 → 上传预检 → 汇入 Aras 的固定链路创建 Project Template 与完整 WBS"
                       FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{ThemeResource CardStyle}" Padding="16">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="28" Height="28" CornerRadius="14" Background="#EEF2FF">
                            <TextBlock Text="1" Foreground="#4F46E5" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="导出标准模板" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="包含模板信息、项目计划示例和真实 Aras 关系说明。"
                               FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                    <Button Content="导出项目计划模板" Command="{Binding DownloadTemplateCommand}"
                            Style="{ThemeResource PrimaryButton}" Height="34" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{ThemeResource CardStyle}" Padding="16">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="28" Height="28" CornerRadius="14" Background="#EEF2FF">
                            <TextBlock Text="2" Foreground="#4F46E5" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="上传并预检" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding FileName}" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="上传模板" Command="{Binding UploadTemplateCommand}"
                                Style="{ThemeResource PrimaryButton}" Height="34" />
                        <Button Content="重新预检" Command="{Binding ValidateArasCommand}" Height="34" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{ThemeResource CardStyle}" Padding="16">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="28" Height="28" CornerRadius="14" Background="#EEF2FF">
                            <TextBlock Text="3" Foreground="#4F46E5" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="汇入 Aras" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding ArasValidationMessage}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                    <Button Content="确认汇入项目计划" Command="{Binding ImportCommand}"
                            Style="{ThemeResource AccentButton}" Height="34" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{ThemeResource CardStyle}" Padding="16,12"
                Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="模板名称" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding TemplateName}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="模板说明" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding TemplateDescription}" FontSize="13" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding SummaryText}" FontSize="13" FontWeight="SemiBold"
                           Foreground="#4F46E5" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{ThemeResource SimpleCard}" Padding="0"
                Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid Width="1120" Padding="12,9" Background="#F8F9FB" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55" />
                            <ColumnDefinition Width="95" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="95" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="顺序" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="编码" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="类型" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="父节点" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="名称" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="5" Text="工期(天)" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="6" Text="工时" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="7" Text="前置节点" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="8" Text="项目角色" FontWeight="SemiBold" />
                    </Grid>
                </ScrollViewer>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <ListView ItemsSource="{Binding Nodes}" Width="1120" HorizontalAlignment="Left"
                              SelectionMode="None" Style="{ThemeResource TableListView}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="1096" Padding="8" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="55" />
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding SortOrder}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Code}" />
                                    <TextBlock Grid.Column="2" Text="{Binding DisplayType}" />
                                    <TextBlock Grid.Column="3" Text="{Binding ParentCode}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="5" Text="{Binding ExpectedDuration}" />
                                    <TextBlock Grid.Column="6" Text="{Binding WorkEstimate}" />
                                    <TextBlock Grid.Column="7" Text="{Binding PredecessorCodes}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="8" Text="{Binding ProjectRole}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Spacing="6">
            <ScrollViewer x:Name="ValidationMessageScrollViewer" MaxHeight="220"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="6">
                    <Border Background="#FFFFF7ED" BorderBrush="#FFF59E0B" BorderThickness="1" CornerRadius="6" Padding="10,7"
                            Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding WarningsText}" Foreground="#B45309" FontSize="12" TextWrapping="Wrap" />
                    </Border>
                    <Border Background="#3FEF4444" CornerRadius="6" Padding="10,7"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" FontSize="12" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
            </ScrollViewer>
            <ProgressBar IsIndeterminate="True" Height="4"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Grid>
</Page>
