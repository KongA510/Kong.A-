<Page
    x:Class="ArasToolkit.App.WinUI.Views.PropertyTranslationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,24,30,30" Spacing="16">
            <StackPanel>
                <TextBlock Text="字段翻译" Style="{ThemeResource PageTitleText}" />
                <TextBlock Text="按对象类读取 Property，使用当前 AI 模型生成多语言标签并写回 Aras。"
                           Style="{ThemeResource PageSubtitleText}" />
            </StackPanel>

            <Border Style="{ThemeResource SimpleCard}" Padding="16,12">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE968;" FontSize="16" />
                        <TextBlock Text="{Binding ConnectionText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE99A;" FontSize="16" />
                        <TextBlock Text="{Binding AiModelText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{ThemeResource SimpleCard}" Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="1  选择对象类并加载字段" FontSize="16" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Header="Aras 对象类"
                                  ItemsSource="{Binding FilteredItemTypes}"
                                  SelectedItem="{Binding SelectedItemType, Mode=TwoWay}"
                                  MaxDropDownHeight="360">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox Grid.Column="1" Header="模糊筛选对象类"
                                 PlaceholderText="输入名称或标签，仅筛选左侧列表"
                                 Text="{Binding ItemTypeSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2" Content="刷新对象类" Command="{Binding LoadItemTypesCommand}"
                                VerticalAlignment="Bottom" Height="34" />
                        <Button Grid.Column="3" Content="加载字段" Command="{Binding LoadPropertiesCommand}"
                                Style="{ThemeResource PrimaryButton}" VerticalAlignment="Bottom" Height="34" />
                    </Grid>
                    <TextBlock Text="{Binding ItemTypeFilterSummary}" FontSize="12"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{ThemeResource SimpleCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Padding="18,14" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="2  选择需要翻译的字段" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectionSummary}" FontSize="12"
                                       Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="全选" Command="{Binding SelectAllCommand}" />
                        <Button Grid.Column="2" Content="清空" Command="{Binding ClearSelectionCommand}" />
                    </Grid>
                    <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,1" Padding="16,10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="选择" Style="{ThemeResource TableHeaderText}" />
                            <TextBlock Grid.Column="1" Text="字段名称" Style="{ThemeResource TableHeaderText}" />
                            <TextBlock Grid.Column="2" Text="原标签" Style="{ThemeResource TableHeaderText}" />
                            <TextBlock Grid.Column="3" Text="数据类型" Style="{ThemeResource TableHeaderText}" />
                            <TextBlock Grid.Column="4" Text="翻译预览" Style="{ThemeResource TableHeaderText}" />
                        </Grid>
                    </Border>
                    <ListView Grid.Row="2" ItemsSource="{Binding Properties}" Style="{ThemeResource TableListView}"
                              MaxHeight="380" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,10" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Click="SelectionCheckBox_Click" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{ThemeResource TableCellText}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Label}" Style="{ThemeResource TableCellText}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="3" Text="{Binding DataType}" Style="{ThemeResource TableCellText}" />
                                        <TextBlock Grid.Column="4" Text="{Binding TranslationPreview}" Style="{ThemeResource TableCellText}"
                                                   TextWrapping="Wrap" Foreground="{ThemeResource AccentBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Style="{ThemeResource SimpleCard}" Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="3  在线翻译设置" FontSize="16" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Header="源语言" ItemsSource="{Binding SourceLanguages}"
                                  SelectedItem="{Binding SourceLanguage, Mode=TwoWay}" />
                        <TextBox Grid.Column="1" Header="目标语言（逗号分隔）" Text="{Binding TargetLanguages, Mode=TwoWay}"
                                 PlaceholderText="繁体中文,英文" />
                        <Button Grid.Column="2" Content="开始翻译" Command="{Binding TranslateCommand}"
                                Style="{ThemeResource PrimaryButton}" VerticalAlignment="Bottom" Height="34" />
                        <Button Grid.Column="3" Content="取消" Command="{Binding CancelCommand}"
                                VerticalAlignment="Bottom" Height="34" />
                        <Button Grid.Column="4" Content="导出清单" Command="{Binding ExportCommand}"
                                VerticalAlignment="Bottom" Height="34" />
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercentage}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}" Height="4" />
                    <TextBlock Text="{Binding ProgressText}" FontSize="12"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <InfoBar IsOpen="{Binding HasStatus}" IsClosable="False" Severity="Informational"
                     Message="{Binding StatusMessage}" />
        </StackPanel>
    </ScrollViewer>
</Page>
