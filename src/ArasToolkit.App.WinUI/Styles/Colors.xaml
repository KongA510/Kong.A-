<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 仅保留应用自定义语义色；WinUI 原生控件色由 XamlControlsResources 随系统主题提供。 -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="SystemBaseBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="SystemListLowBrush" Color="#F9F9F9" />
            <SolidColorBrush x:Key="SidebarBgBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#F9F9F9" />
            <SolidColorBrush x:Key="CardBrush" Color="#FCFCFC" />

            <SolidColorBrush x:Key="SystemAccentBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#0067C0" />
            <SolidColorBrush x:Key="PrimaryBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="SecondaryBrush" Color="#F3F3F3" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5D5D5D" />
            <SolidColorBrush x:Key="BorderBrush" Color="#18000000" />

            <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="#66000000" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="SystemBaseBrush" Color="#202020" />
            <SolidColorBrush x:Key="SystemListLowBrush" Color="#272727" />
            <SolidColorBrush x:Key="SidebarBgBrush" Color="#202020" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#272727" />
            <SolidColorBrush x:Key="CardBrush" Color="#2D2D2D" />

            <SolidColorBrush x:Key="SystemAccentBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#60CDFF" />
            <SolidColorBrush x:Key="PrimaryBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="SecondaryBrush" Color="#2D2D2D" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CFCFCF" />
            <SolidColorBrush x:Key="BorderBrush" Color="#26FFFFFF" />

            <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FCE100" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="#99000000" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <CornerRadius x:Key="AppControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
</ResourceDictionary>
